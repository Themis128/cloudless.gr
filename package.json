    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/utils": "^5.0.3",
    "cf": "1.0.0-beta.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "markdownlint-cli2": "^0.23.3",
    "mcp-remote": "^0.14.3",
    "monocart-coverage-reports": "^2.13.0",
    "monocart-reporter": "^2.14.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "project-mcp": "^3.3.0",
    "prompt-to-asset": "^0.5.1",
    "sst": "^4.0.0",
    "stock-images-mcp": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
