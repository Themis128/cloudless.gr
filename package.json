    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "openai": "^7.27.0",
    "openevals": "^0.2.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
