{
  "name": "cloudless-app",
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 4000 --hostname localhost",
    "dev:info": "bash scripts/wsl-dev-info.sh",
    "dev:restart": "bash scripts/dev-server-restart.sh",
    "dev:restart:clean": "bash scripts/dev-server-restart.sh --clean",
    "cluster:health": "bash scripts/cluster-health-snapshot.sh",
    "cluster:doctor": "bash scripts/cluster-doctor.sh",
    "litellm:start": "bash scripts/litellm.sh start",
    "litellm:stop": "bash scripts/litellm.sh stop",
    "litellm:restart": "bash scripts/litellm.sh restart",
    "litellm:status": "bash scripts/litellm.sh status",
    "litellm:logs": "bash scripts/litellm.sh logs",
    "prometheus:tune": "bash scripts/prometheus-tune.sh",
    "lambda:audit": "bash scripts/lambda-env-audit.sh",
    "e2e:smoke": "bash scripts/e2e-smart-run.sh smoke",
    "e2e:full": "bash scripts/e2e-smart-run.sh full",
    "e2e:k3s": "bash scripts/e2e-smart-run.sh k3s",
    "e2e:prod": "bash scripts/e2e-smart-run.sh prod",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:py": "ruff check .",
    "lint:py:fix": "ruff check . --fix",
    "lint:all": "pnpm lint && pnpm lint:md && pnpm lint:py",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:py": "ruff format .",
    "format:py:check": "ruff format --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:py": "mypy scripts infrastructure lambda",
    "evals:seed": "tsx scripts/evals/seed-datasets.mts",
    "evals:run": "tsx scripts/evals/run-eval.ts",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e-with-env.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "deploy": "pnpm run cloudflare-build && pnpm exec sst deploy --config sst.config.cloudflare.ts --stage production",
    "deploy:staging": "pnpm run cloudflare-build && pnpm exec sst deploy --config sst.config.cloudflare.ts --stage staging",
    "deploy:infra-only": "pnpm sst:infra:deploy",
    "deploy:app-only": "pnpm cf:build && pnpm cf:deploy",
    "sst:dev": "sst dev --config sst.config.ts",
    "sst:dev:cf": "sst dev --config sst.config.cloudflare.ts",
    "sst:infra": "sst dev --config sst.config.cf-infra.ts",
    "sst:infra:deploy": "sst deploy --config sst.config.cloudflare.ts --stage production",
    "sst:infra:deploy:staging": "sst deploy --config sst.config.cloudflare.ts --stage staging",
    "sst:infra:remove": "sst remove --config sst.config.cloudflare.ts",
    "devcontainer:preflight": "bash -lc 'if ! command -v docker >/dev/null 2>&1; then echo \"Docker CLI not found in this WSL distro. Enable Docker Desktop WSL integration for this distro.\"; exit 1; fi; if ! docker version >/dev/null 2>&1; then echo \"Docker daemon not reachable from WSL. Start Docker Desktop and wait for Engine running.\"; exit 1; fi; if command -v wsl.exe >/dev/null 2>&1; then wsl.exe -l -v; fi; echo \"Docker is ready for Dev Containers.\"'",
    "devcontainer:doctor": "bash scripts/devcontainer-doctor.sh",
    "devcontainer:stop": "bash scripts/devcontainer-stop.sh",
    "notion:test": "tsx --tsconfig scripts/tsconfig.json scripts/notion-test.ts",
    "cms:populate": "node scripts/populate-cms.mjs",
    "gh:secrets": "tsx --tsconfig scripts/tsconfig.json scripts/gh-secrets.ts",
    "ses:provision": "tsx --tsconfig scripts/tsconfig.json scripts/provision-ses-smtp.ts",
    "domain:decommission": "bash scripts/domain-decommission.sh",
    "gsc:sync": "tsx --tsconfig scripts/tsconfig.json scripts/weekly-gsc-sync.ts",
    "newsletter:draft": "tsx --tsconfig scripts/tsconfig.json scripts/generate-weekly-article.ts",
    "newsletter:send": "tsx --tsconfig scripts/tsconfig.json scripts/publish-and-send-newsletter.ts",
    "newsletter:report": "tsx --tsconfig scripts/tsconfig.json scripts/weekly-subscriber-report.ts",
    "cognito:setup": "bash scripts/cognito-setup.sh",
    "cognito:setup:dry": "bash scripts/cognito-setup.sh --dry-run",
    "cognito:setup:quick": "bash scripts/cognito-setup.sh --skip-verify",
    "workers-ai:doctor": "bash scripts/workers-ai-doctor.sh",
    "e2e:cognito": "bash scripts/e2e-cognito-provision.sh",
    "e2e:cognito:dry": "bash scripts/e2e-cognito-provision.sh --dry-run",
    "mcp-security-scan": "cd tools/mcp-security-scanner && npm install && npm run scan -- --path \"../../src/**/*.{ts,tsx,js,jsx,py,md}\"",
    "mcp-security-scan:server": "cd tools/mcp-security-scanner && npm install && npm run scan -- --path \"../../src/{app/api,lib}/**/*.{ts,tsx,js,jsx,py,md}\"",
    "test:e2e:fullstack": "playwright test e2e/fullstack-frontend-backend.spec.ts",
    "test:e2e:integrations": "playwright test e2e/integrations-contracts.spec.ts",
    "test:k3s": "playwright test --config=playwright.k3s.config.mts",
    "test:k3s:smoke": "playwright test --config=playwright.k3s.config.mts e2e/k3s/smoke.spec.ts",
    "test:e2e:cloudflare": "playwright test e2e/cloudflare-infrastructure.spec.ts",
    "test:e2e:fly": "playwright test e2e/fly-proxy.spec.ts",
    "test:e2e:k3s-system": "playwright test --config=playwright.k3s.config.mts e2e/k3s/system.spec.ts",
    "test:e2e:infra-all": "INFRA_SMOKE=1 pnpm exec playwright test e2e/cloudflare-infrastructure.spec.ts e2e/fly-proxy.spec.ts --config=playwright.k3s.config.mts",
    "e2e:setup": "bash scripts/e2e-env-bootstrap.sh",
    "e2e:setup:ssm": "bash scripts/e2e-env-bootstrap.sh --ssm-only",
    "e2e:setup:print": "bash scripts/e2e-env-bootstrap.sh --print",
    "e2e:run": "bash scripts/e2e-with-env.sh",
    "e2e:run:ui": "bash scripts/e2e-with-env.sh --ui",
    "e2e:run:headed": "bash scripts/e2e-with-env.sh --headed",
    "e2e:run:public": "bash scripts/e2e-with-env.sh --project=chromium",
    "e2e:run:user": "bash scripts/e2e-with-env.sh --project=chromium",
    "e2e:run:admin": "bash scripts/e2e-with-env.sh --project=admin",
    "test:e2e:raw": "playwright test",
    "test:coverage": "COVERAGE=1 bash scripts/e2e-with-env.sh",
    "test:coverage:public": "COVERAGE=1 bash scripts/e2e-with-env.sh --project=chromium",
    "test:coverage:smoke": "COVERAGE=1 bash scripts/e2e-with-env.sh public-pages-deep",
    "coverage:open": "xdg-open coverage/merged/index.html 2>/dev/null || open coverage/merged/index.html 2>/dev/null || echo \"open coverage/merged/index.html\"",
    "test:coverage:full": "COVERAGE=1 NEXT_PUBLIC_COVERAGE=1 bash scripts/e2e-with-env.sh",
    "coverage:clean": "rm -rf coverage/ monocart-report/ .coverage-v8-server/",
    "test:coverage:k3s": "COVERAGE=1 pnpm exec playwright test --config=playwright.k3s.config.mts",
    "test:coverage:all": "pnpm coverage:clean && pnpm test:coverage:full && pnpm test:coverage:k3s && pnpm coverage:merge",
    "coverage:merge": "node scripts/coverage-merge.mjs",
    "analyze": "ANALYZE=true next build",
    "pnpm": "pnpm install",
    "pnpm:update": "pnpm update --interactive",
    "pnpm:audit": "pnpm audit",
    "pnpm:audit:fix": "pnpm audit --fix",
    "pnpm:dedupe": "pnpm dedupe",
    "pnpm:why": "pnpm why",
    "pnpm:list": "pnpm list --depth 0",
    "pnpm:outdated": "pnpm outdated",
    "pnpm:clean": "pnpm store prune && rm -rf node_modules/.cache",
    "pnpm:rebuild": "pnpm rebuild && pnpm run typecheck",
    "dev:webpack": "next dev -p 4000 --webpack --hostname localhost",
    "dev:bigmem": "NODE_OPTIONS=--max-old-space-size=8192 next dev -p 4000 --webpack --hostname localhost",
    "cf:types": "wrangler types",
    "cf:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "cf:dev": "wrangler dev --port 8787",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:free": "wrangler deploy --config wrangler-cloudflare-free.json",
    "cloudflare-build": "pnpm exec opennextjs-cloudflare build --openNextConfigPath open-next.config.cloudflare.ts",
    "cf:build": "next build",
    "cf:build:opennext": "pnpm exec opennextjs-cloudflare build --openNextConfigPath open-next.config.cloudflare.ts",
    "cf:deploy:full": "pnpm cf:build && pnpm cf:r2:upload-static && pnpm cf:deploy",
    "cf:deploy:staging": "wrangler deploy -c wrangler.staging.jsonc",
    "cf:deploy:preview": "wrangler deploy -c wrangler.preview.jsonc",
    "cf:r2:upload-static": "bash scripts/extract-static-assets.sh",
    "cf:deploy:migrate": "bash scripts/deploy-cloudflare.sh",
    "cf:r2:upload-dir": "bash scripts/r2-upload-dir.sh",
    "cf:r2:upload-out": "pnpm exec wrangler r2 object put cloudless-assets --file ./out/index.html index.html",
    "aw:list": "gh aw list",
    "aw:status": "gh aw status",
    "aw:validate": "gh aw validate",
    "aw:workflow": "gh aw run",
    "aw:deploy-pi": "gh aw run deploy-pi",
    "aw:deploy-fly": "gh aw run deploy-fly-proxy",
    "aw:k3s-restart": "gh aw run k3s-restart",
    "aw:k3s-recover": "gh aw run k3s-app-recover",
    "aw:monitoring-fix": "gh aw run monitoring-node-selector-fix",
    "aw:security-scan": "gh aw run mcp-security-scan",
    "aw:monthly-audit": "gh aw run monthly-security-audit",
    "aw:a11y-audit": "gh aw run a11y-audit",
    "aw:lighthouse": "gh aw run lighthouse",
    "aw:cluster-doctor": "gh aw run cluster-doctor",
    "aw:etl-espocrm": "gh aw run etl-espocrm-to-r2"
  },
