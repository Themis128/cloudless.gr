    "cmdk": "^1.1.1",
    "countup.js": "^2.10.1",
    "gsap": "^3.12.5",
    "hono-agents": "^3.0.12",
    "jose": "^6.2.12",
    "langsmith": "^0.10.7",
    "lenis": "^1.3.26",
