{
  "name": "cloudless-app",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 4000",
    "dev:info": "bash scripts/wsl-dev-info.sh",
    "dev:restart": "bash scripts/dev-server-restart.sh",
    "dev:restart:clean": "bash scripts/dev-server-restart.sh --clean",
    "cluster:health": "bash scripts/cluster-health-snapshot.sh",
    "cluster:doctor": "bash scripts/cluster-doctor.sh",
    "prometheus:tune": "bash scripts/prometheus-tune.sh",
    "lambda:audit": "bash scripts/lambda-env-audit.sh",
    "db:forward": "bash scripts/db-port-forward.sh",
    "db:forward:status": "bash scripts/db-port-forward.sh status",
    "db:forward:stop": "bash scripts/db-port-forward.sh stop",
    "db:passwords": "bash scripts/db-port-forward.sh passwords",
    "db:sqlite:pull": "bash scripts/db-sqlite-pull.sh",
    "db:d1:pull": "bash scripts/db-d1-pull.sh",
    "db:ready": "bash scripts/db-port-forward.sh && bash scripts/db-port-forward.sh status",
    "db:refresh-snapshots": "bash scripts/db-sqlite-pull.sh && bash scripts/db-d1-pull.sh",
    "db:backup:test": "bash scripts/pvc-backup-test.sh",
    "d1:retire:cloudless-auth": "bash scripts/d1-retire-cloudless-auth.sh",
    "e2e:smoke": "bash scripts/e2e-smart-run.sh smoke",
    "e2e:full": "bash scripts/e2e-smart-run.sh full",
    "e2e:k3s": "bash scripts/e2e-smart-run.sh k3s",
    "e2e:prod": "bash scripts/e2e-smart-run.sh prod",
    "e2e:chunk": "bash scripts/e2e-chunked.sh",
    "e2e:chunk:list": "bash scripts/e2e-chunked.sh list",
    "e2e:chunk:all": "bash scripts/e2e-chunked.sh all",
    "build": "node scripts/sst-next-build.mjs",
    "start": "next start -p 4000",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:yaml": "bash scripts/lint-yaml.sh",
    "lint:py": "ruff check .",
    "lint:py:fix": "ruff check . --fix",
    "lint:all": "pnpm lint && pnpm lint:md && pnpm lint:yaml && pnpm lint:py",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:py": "ruff format .",
    "format:py:check": "ruff format --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:py": "mypy scripts infrastructure lambda",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "bash scripts/e2e-with-env.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:public": "playwright test --project=chromium",
    "test:e2e:user": "playwright test --project=chromium e2e/dashboard.spec.ts e2e/auth.spec.ts",
    "test:e2e:admin": "playwright test --project=chromium e2e/admin.spec.ts e2e/admin-api-deep.spec.ts",
    "test:e2e:raw": "playwright test",
    "test:coverage": "COVERAGE=1 bash scripts/e2e-with-env.sh",
    "test:coverage:public": "COVERAGE=1 bash scripts/e2e-with-env.sh --project=chromium",
    "test:coverage:smoke": "COVERAGE=1 bash scripts/e2e-with-env.sh public-pages-deep",
    "coverage:open": "xdg-open coverage/merged/index.html 2>/dev/null || open coverage/merged/index.html 2>/dev/null || echo \"open coverage/merged/index.html\"",
    "test:coverage:full": "COVERAGE=1 NEXT_PUBLIC_COVERAGE=1 bash scripts/e2e-with-env.sh",
    "coverage:clean": "rm -rf coverage/ monocart-report/ .coverage-v8-server/",
    "test:coverage:k3s": "COVERAGE=1 npx playwright test --config=playwright.k3s.config.mts",
    "test:coverage:all": "pnpm coverage:clean && pnpm test:coverage:full && pnpm test:coverage:k3s && pnpm coverage:merge",
    "coverage:merge": "node scripts/coverage-merge.mjs",
    "test:unit:coverage": "mkdir -p coverage/vitest/.tmp && vitest run --coverage --pool=forks --maxWorkers=1",
    "test:unit:coverage:ci": "mkdir -p coverage/vitest/.tmp && vitest run --coverage --pool=forks --maxWorkers=1 --reporter=default",
    "analyze": "ANALYZE=true next build",
    "cf:build": "bash scripts/cf-build-wrapper.sh",
    "cf:build:opennext": "bash scripts/cf-build-wrapper.sh",
    "cf:deploy": "opennextjs-cloudflare deploy --minify",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1073.0",
    "@aws-sdk/client-cost-explorer": "^3.1073.0",
    "@aws-sdk/client-dynamodb": "^3.1073.0",
    "@aws-sdk/client-sesv2": "^3.1073.0",
    "@aws-sdk/client-ssm": "^3.1073.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@langchain/langgraph-sdk": "^1.9.28",
    "@opennextjs/cloudflare": "^1.20.2",
    "@sentry/nextjs": "^10.59.0",
    "agents": "^0.20.1",
    "ai": "^7.0.42",
    "aws4fetch": "^1.0.20",
    "cmdk": "^1.1.1",
    "countup.js": "^2.10.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.21.0",
    "mqtt": "^5.15.1",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.1",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "stripe": "^22.2.2",
    "undici": "^8.5.0",
    "workers-ai-provider": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "3.1098.0",
    "@axe-core/playwright": "^4.11.3",
    "@executeautomation/playwright-mcp-server": "^1.0.12",
    "@next/bundle-analyzer": "16.2.12",
    "@notionhq/notion-mcp-server": "^2.5.1",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "monocart-coverage-reports": "^2.12.12",
    "monocart-reporter": "^2.11.2",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "project-mcp": "^3.3.0",
    "sst": "^4.15.2",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "brace-expansion": "5.0.8",
      "minimatch": "10.2.5",
      "sharp@<0.35.0": ">=0.35.0",
      "js-cookie@<3.0.7": ">=3.0.7",
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild": ">=0.28.1",
      "ws@<8.21.0": ">=8.21.0",
      "markdown-it@<14.2.0": ">=14.2.0",
      "undici@<7.28.0": "7.28.0",
      "nodemailer@<8.0.11": ">=8.0.11",
      "js-yaml": "4.3.0",
      "next-auth": "5.0.0-beta.32",
      "@auth/core": ">=0.41.3",
      "@modelcontextprotocol/sdk": ">=1.26.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "uuid@<11.1.1": ">=11.1.1",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "ai@<5.0.52": "5.0.223",
      "@opentelemetry/core@<2.8.0": ">=2.8.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "workerd"
    ]
  }
}