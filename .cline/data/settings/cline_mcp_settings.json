{
  "mcpServers": {
    "cloudflare-pages": {
      "command": "npx",
      "args": ["tsx", "cloudflare-pages-mcp/src/index.ts"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID:-fb7dc7b69b662480cd5961a4d1913c78}"
      },
      "autoStart": false,
      "alwaysAllow": [
        "pages_list_projects",
        "pages_get_project",
        "pages_list_deployments",
        "pages_get_deployment_logs"
      ]
    },
    "cloudflare-builds": {
      "command": "npx",
      "args": ["mcp-remote", "https://builds.mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false,
      "alwaysAllow": []
    },
    "cloudflare-observability": {
