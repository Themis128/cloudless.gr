{
  "version": "1.0.0",
  "project": "cloudless.gr",
  "description": "Next.js 16 + Cloudflare Workers full-stack application",
  "settings": {
    "maxTokensPerTask": 64000,
    "defaultModel": "claude-sonnet-4-20250514",
    "autoApprove": {
      "readOperations": true,
      "fileOperations": false,
      "commandExecution": false,
      "networkOperations": false
    },
    "context": {
      "maxFilesToRead": 15,
      "maxSearchResults": 20,
      "autoIncludeFiles": [
        "AGENTS.md",
        "package.json",
        "wrangler.jsonc",
        "next.config.ts",
        "open-next.config.ts"
      ]
    },
    "hooks": {
      "enabled": true,
      "directory": ".cline/hooks"
    },
    "rules": {
      "enabled": true,
      "directory": ".cline/rules"
    },
    "mcp": {
      "autoStartServers": [
        "fast-markdown",
        "cloudflare-bindings",
        "cloudflare",
        "sequentialthinking",
        "github",
        "github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
      ],
      "alwaysAllowTools": {
        "fast-markdown": ["list_files", "read_file", "search_files", "get_toc"],
        "cloudflare-bindings": ["kv_namespaces_list", "r2_buckets_list", "workers_list"],
        "cloudflare": ["*"],
        "sequentialthinking": ["sequentialthinking"],
        "github": ["search_repos", "search_code", "search_issues", "get_file_contents", "get_issue", "list_issues", "get_pull_request", "list_pull_requests", "get_repo", "list_branches", "list_commits", "get_workflow_run", "list_workflow_runs"],
        "github.com/modelcontextprotocol/servers/tree/main/src/filesystem": ["read_text_file", "read_multiple_files", "write_file", "edit_file", "create_directory", "list_directory", "search_files", "directory_tree", "get_file_info"]
      }
    },
    "skills": {
      "autoLoad": [
        "cloudflare",
        "workers-best-practices",
        "wrangler",
        "opennext-build-deploy",
        "e2e-testing",
        "playwright-cli",
        "slack-app-routes-nextjs",
