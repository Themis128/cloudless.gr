{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudless-web",
  "compatibility_date": "2026-07-20",
  "minify": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "assets": {
    "binding": "ASSETS",
    "directory": "./out"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "cloudless.gr",
          "zone_id": "7025298073d6a5c645a6ad9add0cbf0e",
          "custom_domain": true
        },
        {
          "pattern": "www.cloudless.gr",
          "zone_id": "7025298073d6a5c645a6ad9add0cbf0e",
          "custom_domain": true
        }
      ],
      "_note_account_id": "CLOUDFLARE_ACCOUNT_ID must be the account that owns user-auth-db D1 (fb7dc7…), matching top-level account_id. A mismatch makes D1 REST return 401 and breaks /api/auth/login.",
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        }
      },
      "vars": {
        "ENVIRONMENT": "production",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
        "CLOUDFLARE_ACCOUNT_ID": "fb7dc7b69b662480cd5961a4d1913c78"
      },
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "CRON_SECRET",
          "CLOUDFLARE_API_TOKEN"
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "cloudless_analytics"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "cloudless-assets"
        },
        {
          "binding": "CACHE_BUCKET",
          "bucket_name": "cloudless-assets"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "app-media-bucket"
        },
        {
          "binding": "ANALYTICS_BUCKET",
          "bucket_name": "cloudless-analytics"
        },
        {
          "binding": "DATALAKE_BUCKET",
          "bucket_name": "datalake-bucket"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "cloudless-assets"
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        }
      ]
    },
    "staging": {
      "name": "cloudless-gr-staging",
      "routes": [
        {
          "pattern": "staging.cloudless.gr",
          "zone_id": "7025298073d6a5c645a6ad9add0cbf0e",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr"
      },
      "secrets": {
        "required": []
      },
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "cloudless-assets"
        },
        {
          "binding": "CACHE_BUCKET",
          "bucket_name": "cloudless-assets"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "app-media-bucket"
        },
        {
          "binding": "ANALYTICS_BUCKET",
          "bucket_name": "cloudless-analytics"
        },
        {
          "binding": "DATALAKE_BUCKET",
          "bucket_name": "datalake-bucket"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "cloudless-assets"
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        }
      ]
    }
  },
  "main": "src/index.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
    "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
    "CLOUDFLARE_ACCOUNT_ID": "fb7dc7b69b662480cd5961a4d1913c78"
  },
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "CRON_SECRET",
      "CLOUDFLARE_API_TOKEN"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "cloudless-assets"
    },
    {
      "binding": "CACHE_BUCKET",
      "bucket_name": "cloudless-assets"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "app-media-bucket"
    },
    {
      "binding": "ANALYTICS_BUCKET",
      "bucket_name": "cloudless-analytics"
    },
    {
      "binding": "DATALAKE_BUCKET",
      "bucket_name": "datalake-bucket"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cloudless-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    }
  ]
}
