{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudless-gr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CounterAgent",
        "class_name": "CounterAgent"
      },
      {
        "name": "EchoAgent",
        "class_name": "EchoAgent"
      },
      {
        "name": "CodingAgent",
        "class_name": "CodingAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CounterAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EchoAgent"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CodingAgent"
      ]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "cloudless-assets"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "app-media-bucket"
    },
    {
      "binding": "ANALYTICS_BUCKET",
      "bucket_name": "cloudless-analytics"
    },
    {
      "binding": "DATALAKE_BUCKET",
      "bucket_name": "datalake-bucket"
    }
  ],
  "services": [
    {
      "binding": "CHAT",
      "service": "cloudless-chat",
      "entrypoint": "ChatAgent"
    },
    {
      "binding": "ADMIN_API",
      "service": "cloudless-admin-api",
      "entrypoint": "AdminApi"
    }
  ],
  "env": {
    "staging": {
      "name": "cloudless-gr-staging",
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "auth-db-preview",
          "database_id": "70d90155-12de-46d7-a0ea-113b3e7127cf"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "cloudless-assets-preview"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "app-media-bucket-preview"
        },
        {
          "binding": "ANALYTICS_BUCKET",
          "bucket_name": "cloudless-analytics-preview"
        },
        {
          "binding": "DATALAKE_BUCKET",
          "bucket_name": "datalake-bucket-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "NEXT_PUBLIC_SITE_URL": "https://staging.cloudless.gr"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "cloudless-assets"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "app-media-bucket"
        },
        {
          "binding": "ANALYTICS_BUCKET",
          "bucket_name": "cloudless-analytics"
        },
        {
          "binding": "DATALAKE_BUCKET",
          "bucket_name": "datalake-bucket"
        }
      ]
    }
  },
  "vars": {
    "AGENT_AUTH_TOKEN": "placeholder-override-in-production",
    "SESSION_SECRET": "${SESSION_SECRET}",
    "CRON_SECRET": "${CRON_SECRET}"
  }
}