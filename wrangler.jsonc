{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudless-gr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CounterAgent",
        "class_name": "CounterAgent"
      },
      {
        "name": "EchoAgent",
        "class_name": "EchoAgent"
      },
      {
        "name": "CodingAgent",
        "class_name": "CodingAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CounterAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EchoAgent"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CodingAgent"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "cloudless.gr/api/agents/*",
      "custom_domain": false
    },
    {
      "pattern": "cloudless.gr/agents/*",
      "custom_domain": false
    },
    {
      "pattern": "cloudless.gr/api/server/counter/*",
      "custom_domain": false
    }
  ],
  "vars": {
    "AGENT_AUTH_TOKEN": ""
  }
}