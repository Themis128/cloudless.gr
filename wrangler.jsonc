{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudless-gr",
  "main": "src/index.ts",
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "routes": [
    { "pattern": "cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e" }
  ],
  "compatibility_date": "2026-07-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    },
    {
      "binding": "NEXT_CACHE_D1_BINDING",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TAG_CACHE",
      "id": "e81bb5dcf84b452b978323f09a3f7428"
    },
    {
      "binding": "REVALIDATION_QUEUE",
      "id": "b5b95ab1caed42a8b6e14f5db869bbc6"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "cloudless-assets"
    },
    {
      "binding": "CACHE_BUCKET",
      "bucket_name": "cloudless-assets"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "app-media-bucket"
    },
    {
      "binding": "ANALYTICS_BUCKET",
      "bucket_name": "cloudless-analytics"
    },
    {
      "binding": "DATALAKE_BUCKET",
      "bucket_name": "datalake-bucket"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cloudless-assets"
    }
  ],
  "env": {
    "staging": {
      "name": "cloudless-gr-staging",
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "auth-db-preview",
          "database_id": "70d90155-12de-46d7-a0ea-113b3e7127cf"
        },
        {
          "binding": "NEXT_CACHE_D1_BINDING",
          "database_name": "auth-db-preview",
          "database_id": "70d90155-12de-46d7-a0ea-113b3e7127cf"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TAG_CACHE",
          "id": "4acd41f02601469097d2f447f8a86e11"
        },
        {
          "binding": "REVALIDATION_QUEUE",
          "id": "9af1742d16af429f96f75e8228706bd8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "cloudless-assets-preview"
        },
        {
          "binding": "CACHE_BUCKET",
          "bucket_name": "cloudless-assets-preview"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "app-media-bucket-preview"
        },
        {
          "binding": "ANALYTICS_BUCKET",
          "bucket_name": "cloudless-analytics-preview"
        },
        {
          "binding": "DATALAKE_BUCKET",
          "bucket_name": "datalake-bucket-preview"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "cloudless-assets-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "NEXT_PUBLIC_SITE_URL": "https://staging.cloudless.gr"
      }
    }
  },
}