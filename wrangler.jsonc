{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cloudless-gr",
	"main": "src/index-cloudflare-free.js",
	"compatibility_date": "2026-07-01",
	"account_id": "fb7dc7b69b662480cd5961a4d1913c78",
	// Note: assets binding removed - Worker uses ASSETS_BUCKET (R2) directly for static
	// ─── Workers AI ──────────────────────────────────────────────────
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// ─── Durable Objects ─────────────────────────────────────────────
	"durable_objects": {
		"bindings": [
			{
				"name": "CounterAgent",
				"class_name": "CounterAgent"
			},
			{
				"name": "EchoAgent",
				"class_name": "EchoAgent"
			},
			{
				"name": "CodingAgent",
				"class_name": "CodingAgent"
		]
	},
	// ─── Workflows ───────────────────────────────────────────────────
	"workflows": [
		{
			"binding": "HelloWorkflow",
			"name": "hello-workflow",
			"class_name": "HelloWorkflow"
		}
	],
	// ─── Migrations ──────────────────────────────────────────────────
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CounterAgent",
				"EchoAgent",
				"CodingAgent"
			]
		}
	],
	// ─── Observability ───────────────────────────────────────────────
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// ─── Routes ───────────────────────────────────────────────────────
	// Main site served by this Worker - decommissions CloudFront
	"routes": [
		{
			"pattern": "cloudless.gr",
			"custom_domain": true
		},
		{
			"pattern": "www.cloudless.gr",
			"custom_domain": true
		}
	],
	// ─── R2 Buckets (Cloudflare Free Tier) ───────────────────────────
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "cloudless-assets"
		},
		{
			"binding": "ANALYTICS_BUCKET",
			"bucket_name": "cloudless-analytics"
		},
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "app-media-bucket",
			"remote": true
		},
		{
			"binding": "DATALAKE_BUCKET",
			"bucket_name": "datalake-bucket",
			"remote": true
		}
	],
	// ─── D1 Database (Cloudflare Free Tier) ──────────────────────────
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "user-auth-db",
			"database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
		}
	],
	// ─── Analytics Engine (Time-series Database) ───────────────────────
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "cloudless-analytics"
		}
	],
	// ─── Email Service (Cloudflare Email) ────────────────────────────
	"send_email": [
		{ "name": "EMAIL" }
	],
	// ─── Environment Variables (non-secret) ──────────────────────────
	"vars": {
		"NEXT_PUBLIC_AUTH_PROVIDER": "d1",
		"NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
		"NEXT_PUBLIC_APP_URL": "https://cloudless.gr",
		"NEXT_PUBLIC_COGNITO_USER_POOL_ID": "",
		"NEXT_PUBLIC_COGNITO_CLIENT_ID": "",
		"AWS_REGION": "us-east-1",
		"AWS_DEFAULT_REGION": "us-east-1",
		"SESSION_TOKEN_STORE_TABLE": "cloudless-session-tokens",
		"USER_PROFILE_TABLE": "cloudless-user-profiles",
		"STRIPE_TRANSACTIONS_TABLE": "cloudless-stripe-transactions",
		"ADMIN_NOTIFICATIONS_TABLE": "cloudless-admin-notifications",
		"ANALYTICS_CACHE_TABLE": "cloudless-analytics-cache",
		"APP_VERSION": "local-dev"
	},
	// ─── Required Secrets ─────────────────────────────────────────────
	"secrets": {
		"required": [
			"SESSION_SECRET",
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"AUTH_SECRET"
		]
	},
	// ─── Environments ────────────────────────────────────────────────
	"env": {
		"staging": {
			"name": "cloudless-gr-staging",
			"routes": [
				{
					"pattern": "staging.cloudless.gr",
					"custom_domain": true
				}
			],
			"workflows": [
				{
					"binding": "HelloWorkflow",
					"name": "hello-workflow",
					"class_name": "HelloWorkflow"
				}
			],
			"r2_buckets": [
				{
					"binding": "ASSETS_BUCKET",
					"bucket_name": "cloudless-assets"
				},
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "app-media-bucket",
					"remote": true
				},
				{
					"binding": "ANALYTICS_BUCKET",
					"bucket_name": "cloudless-analytics"
				},
				{
					"binding": "DATALAKE_BUCKET",
					"bucket_name": "datalake-bucket",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "user-auth-db",
					"database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
				}
			],
			"send_email": [
				{ "name": "EMAIL" }
			],
			"ai": {
				"binding": "AI",
				"remote": true
			},
			"vars": {
				"NEXT_PUBLIC_AUTH_PROVIDER": "d1",
				"NEXT_PUBLIC_SITE_URL": "https://staging.cloudless.gr",
				"NEXT_PUBLIC_APP_URL": "https://staging.cloudless.gr"
			}
		},
		"production": {
			"name": "cloudless-gr",
			"routes": [
				{
					"pattern": "cloudless.gr",
					"custom_domain": true
				},
				{
					"pattern": "www.cloudless.gr",
					"custom_domain": true
				}
			],
			"workflows": [
				{
					"binding": "HelloWorkflow",
					"name": "hello-workflow",
					"class_name": "HelloWorkflow"
				}
			],
			"r2_buckets": [
				{
					"binding": "ASSETS_BUCKET",
					"bucket_name": "cloudless-assets"
				},
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "app-media-bucket",
					"remote": true
				},
				{
					"binding": "ANALYTICS_BUCKET",
					"bucket_name": "cloudless-analytics"
				},
				{
					"binding": "DATALAKE_BUCKET",
					"bucket_name": "datalake-bucket",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "user-auth-db",
					"database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
				}
			],
			"send_email": [
				{ "name": "EMAIL" }
			],
			"ai": {
				"binding": "AI",
				"remote": true
			},
			"vars": {
				"NEXT_PUBLIC_AUTH_PROVIDER": "d1",
				"NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
				"NEXT_PUBLIC_APP_URL": "https://cloudless.gr"
			}
		}
	}
}