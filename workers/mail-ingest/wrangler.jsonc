{
  "name": "mail-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "workers_dev": false,
  "vars": {
    // Prefer webmail path until tunnel API token has Cloudflare Tunnel:Edit
    // for dedicated hostname mail-ingest.cloudless.gr (DNS already exists).
    "MAIL_INGEST_URL": "https://webmail.cloudless.gr/ingest",
    "FALLBACK_FORWARD": "themis.baltzakis@gmail.com",
    "SPAM_TAG_AT": "4",
    "SPAM_REJECT_AT": "9",
    "SPAM_BLOCK_SENDERS": "",
    // Mail→Slack bridge: slack@cloudless.gr is mirrored to the workspace.
    // SLACK_INGEST_SECRET stays a wrangler secret — never a var.
    "SLACK_INGEST_URL": "https://cloudless.gr/api/slack/inbound-email",
    "SLACK_ROUTE_PREFIXES": "slack"
  }
}
