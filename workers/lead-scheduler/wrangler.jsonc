{
  "name": "lead-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "LEAD_FOLLOWUP", "class_name": "LeadFollowup" },
      { "name": "BOOKING_SLOT", "class_name": "BookingSlot" },
      { "name": "WEBHOOK_DEDUP", "class_name": "WebhookDedup" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LeadFollowup", "BookingSlot", "WebhookDedup"],
    },
  ],
  "logpush": true,
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "vars": {
    "WORKER_NAME": "lead-scheduler",
    // Where an alarm dispatch is forwarded (mail-outbound worker or
    // SocialAuto endpoint) — configured via secret MAIL_OUTBOUND_URL.
    "STEP_DELAYS_HOURS": "24,72,168",
    // Public origin used to build signed unsubscribe links in dispatch
    // bodies, e.g. "https://lead-scheduler.<subdomain>.workers.dev".
    // REQUIRED — empty defers dispatch via the retry path (mail without
    // an unsubscribe URL is non-compliant).
    "PUBLIC_BASE_URL": "",
  },
}
