{
  "name": "lead-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "LEAD_FOLLOWUP", "class_name": "LeadFollowup" },
      { "name": "BOOKING_SLOT", "class_name": "BookingSlot" },
      { "name": "WEBHOOK_DEDUP", "class_name": "WebhookDedup" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["LeadFollowup", "BookingSlot", "WebhookDedup"]
    }
  ],
  "observability": { "logpush": true },
  "vars": {
    "WORKER_NAME": "lead-scheduler",
    // Where an alarm dispatch is forwarded (mail-outbound worker or
    // SocialAuto endpoint) — configured via secret MAIL_OUTBOUND_URL.
    "STEP_DELAYS_HOURS": "24,72,168"
  }
}
