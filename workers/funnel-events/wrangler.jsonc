{
  "name": "funnel-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Pipelines binding → R2 (Iceberg tables, cloudless-datalake bucket,
  // events/ prefix). Create the pipeline once via:
  //   wrangler pipelines create cloudless-funnel-events \
  //     --r2-bucket cloudless-datalake --compression gzip
  "pipelines": [
    {
      "binding": "FUNNEL_PIPELINE",
      "stream": "6e1951f9168d4427a3ba525da36397a7"
    }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "vars": {
    "WORKER_NAME": "funnel-events"
  }
}
