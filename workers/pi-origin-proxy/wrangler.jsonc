{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudless2",
  "main": "src/index.ts",
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "compatibility_date": "2026-08-07",
  "minify": true,
  // Apex + www are bound as Cloudflare **Custom Domains** (wrangler asserts
  // them via `custom_domain: true`). `manage.cloudless.gr` used to have a
  // plain Route here but the DNS record for that hostname is a proxied
  // CNAME to the shared Cloudflare Tunnel; the Route caused the Worker to
  // intercept traffic and re-hop through pi-origin.cloudless.gr on the way
  // to the same tunnel. Removed so `manage.*` flows tunnel-only.
  "routes": [
    { "pattern": "cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true },
    { "pattern": "www.cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true }
  ],
  // Explicit empty crons array clears any Cron Triggers previously attached
  // to this Worker. The proxy has no scheduled() handler; every fire from
  // an orphan cron becomes a wasted invocation and a 5xx error. Do NOT add
  // cron entries here — this Worker is fetch-only.
  "triggers": {
    "crons": []
  },
  "vars": {
    "PI_ORIGIN_HOST": "pi-origin.cloudless.gr",
    "PI_TIMEOUT_MS": "30000"
  }
}
