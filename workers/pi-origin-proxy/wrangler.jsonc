{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudless2",
  "main": "src/index.ts",
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "compatibility_date": "2026-08-07",
  "minify": true,
  // apex + www are bound as Cloudflare Custom Domains (`custom_domain: true`).
  // manage.cloudless.gr is intentionally NOT routed to this Worker — it is
  // served directly by the Cloudflare Tunnel -> Pi cloudless-app (cron
  // callers hit that host to dodge Bot Fight Mode). Do NOT add a manage
  // route here: a bare route would silently reappear on the next
  // `wrangler deploy` and steal manage traffic from the Tunnel.
  "routes": [
    {
      "pattern": "cloudless.gr",
      "zone_id": "7025298073d6a5c645a6ad9add0cbf0e",
      "custom_domain": true,
    },
    {
      "pattern": "www.cloudless.gr",
      "zone_id": "7025298073d6a5c645a6ad9add0cbf0e",
      "custom_domain": true,
    },
  ],
  // Explicit empty crons array clears any Cron Triggers previously attached
  // to this Worker. The proxy has no scheduled() handler; every fire from
  // an orphan cron becomes a wasted invocation and a 5xx error. Do NOT add
  // cron entries here — this Worker is fetch-only.
  "triggers": {
    "crons": [],
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics",
    },
  ],
  "vars": {
    "PI_ORIGIN_HOST": "pi-origin.cloudless.gr",
    "PI_TIMEOUT_MS": "30000",
  },
}
