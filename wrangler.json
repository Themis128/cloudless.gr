{
  "name": "cloudless1",
  "main": "src/index-cloudflare-free.js",
  "compatibility_date": "2026-07-09",
  "assets": { "directory": "./out" },
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "routes": [
    { "pattern": "cloudless.gr", "custom_domain": true },
    { "pattern": "www.cloudless.gr", "custom_domain": true },
    { "pattern": "staging.cloudless.gr", "custom_domain": true }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 6 ? * MON-FRI *",
      "0 * * * *",
      "0 2 ? * SUN *",
      "0 5 ? * MON *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_VERSION": "v1.0",
    "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
    "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
    "APP_VERSION": "${GITHUB_SHA}",
    "SESSION_SECRET": "${SESSION_SECRET}"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "cloudless_analytics" }
  ],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
    { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
    { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
  ],
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
  ],
  "env": {
    "staging": {
      "name": "cloudless-gr-staging",
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "API_VERSION": "v1.0",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://staging.cloudless.gr",
        "APP_VERSION": "staging",
        "SESSION_SECRET": "${SESSION_SECRET}"
      },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "cloudless_analytics" }],
      "ai": { "binding": "AI" },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
        { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
        { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
      ],
      "d1_databases": [
        { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
      ]
    },
    "production": {
      "name": "fully-migrated-serverless-stack",
      "routes": [],
      "vars": {
        "ENVIRONMENT": "production",
        "API_VERSION": "v1.0",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
        "APP_VERSION": "${GITHUB_SHA}",
        "SESSION_SECRET": "${SESSION_SECRET}"
      },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "cloudless_analytics" }],
      "ai": { "binding": "AI" },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
        { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
        { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
      ],
      "d1_databases": [
        { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
      ]
    }
  }
}