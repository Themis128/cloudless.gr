    {
      "src": "tag:ci",
      "accept": [
        "tag:pi:22",
        "tag:pi:6443",
        "tag:pi:30700"
      ],
      "deny": [
        "tag:k8s:22"
      ]
    },
    {
      "src": "tag:k8s",
      "accept": [
        "tag:pi:6443",
        "tag:pi:22"
