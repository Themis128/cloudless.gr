#!/usr/bin/env bash
# Guard: block pushes that target the protected default branch directly.
# GitHub rejects them anyway (GH006) — fail locally with the right commands
# instead of a remote error.
set -u

blocked=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "[pre-push] direct push to protected '${remote_ref#refs/heads/}' — rejected locally" >&2
      blocked=1
      ;;
  esac
done
[ "$blocked" = 0 ] && exit 0

cur="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '<branch>')"
if [ "$cur" = "main" ] || [ "$cur" = "master" ]; then
  cat >&2 <<MSG
[pre-push] this repo merges via PR + required checks. Instead:
[pre-push]   git switch -c <feature-branch>
[pre-push]   git push -u origin <feature-branch>
[pre-push]   gh pr create --fill
MSG
else
  cat >&2 <<MSG
[pre-push] this repo merges via PR + required checks. Instead:
[pre-push]   git push -u origin $cur
[pre-push]   gh pr create --fill
MSG
fi
exit 1
