{
  "mcpServers": {
    "cloudless-infra": {
      "command": "node",
      "args": [
        "C:/Users/baltz/AppData/Roaming/kiro/tools/ssh-mcp/dist/index.js"
      ],
      "env": {
        "OMV_SSH_HOST_TAILSCALE": "100.113.41.119",
        "OMV_SSH_USER": "omv",
        "OMV_SSH_KEY": "C:/Users/baltz/.ssh/id_ed25519",
        "OMV_SSH_KEY_CONTENTS": "${OMV_SSH_KEY_CONTENTS}"
      },
      "autoApprove": [
        "ssh_execute",
        "run_cmd",
        "read_file"
      ]
    },
    "project": {
      "command": "npx",
      "args": [
        "--no-install",
        "project-mcp"
      ],
      "autoStart": true,
      "autoApprove": [
        "search",
        "read",
        "write"
      ]
    },
    "notion": {
      "command": "npx",
      "args": [
        "--no-install",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\":\"Bearer ${NOTION_API_KEY}\",\"Notion-Version\":\"2022-06-28\"}"
      },
      "autoStart": true,
      "autoApprove": [
        "search_pages",
        "get_block"
      ]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoApprove": [
        "deploy",
        "kv_get",
        "kv_put",
        "search"
      ]
    }
  }
}