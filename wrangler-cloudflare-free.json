{
  "name": "cloudless-gr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "minify": true,
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "fb7dc7b69b662480cd5961a4d1913c78",
  "routes": [
    { "pattern": "cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true },
    { "pattern": "www.cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true },
    { "pattern": "staging.cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 6 * * 1-5",
      "0 * * * *",
      "0 2 * * 7",
      "0 5 * * 1"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EchoAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CodingAgent"]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CounterAgent", "class_name": "CounterAgent" },
      { "name": "EchoAgent", "class_name": "EchoAgent" },
      { "name": "CodingAgent", "class_name": "CodingAgent" }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_VERSION": "v1.0",
    "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
    "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
    "APP_VERSION": "1.0.0"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
    { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
    { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
  ],
  "kv_namespaces": [
    { "binding": "TAG_CACHE", "id": "e81bb5dcf84b452b978323f09a3f7428" },
    { "binding": "REVALIDATION_QUEUE", "id": "b5b95ab1caed42a8b6e14f5db869bbc6" }
  ],
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
  ],
  "env": {
    "staging": {
      "name": "cloudless-gr-staging",
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "API_VERSION": "v1.0",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://staging.cloudless.gr",
        "APP_VERSION": "staging"
      },
      "kv_namespaces": [
        { "binding": "TAG_CACHE", "id": "4acd41f02601469097d2f447f8a86e11" },
        { "binding": "REVALIDATION_QUEUE", "id": "9af1742d16af429f96f75e8228706bd8" }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "cloudless_analytics"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
        { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
        { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
      ],
      "d1_databases": [
        { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
      ]
    },
    "production": {
      "name": "cloudless-gr",
      "routes": [],
      "vars": {
        "ENVIRONMENT": "production",
        "API_VERSION": "v1.0",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr",
        "APP_VERSION": "1.0.0"
      },
      "kv_namespaces": [
        { "binding": "TAG_CACHE", "id": "e81bb5dcf84b452b978323f09a3f7428" },
        { "binding": "REVALIDATION_QUEUE", "id": "b5b95ab1caed42a8b6e14f5db869bbc6" }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "cloudless_analytics"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
        { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
        { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" }
      ],
      "d1_databases": [
        { "binding": "AUTH_DB", "database_name": "user-auth-db", "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d" }
      ]
    }
  }
}