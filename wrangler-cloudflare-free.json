{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudless-gr-free",
  "compatibility_date": "2026-07-20",
  "minify": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "c6d6b805741159c062a3e0b0d7f9d89a",
  "routes": [
    { "pattern": "cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true },
    { "pattern": "www.cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out"
  },
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 6 * * 1-5",
      "0 * * * *",
      "0 2 * * 7",
      "0 5 * * 1"
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CounterAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["EchoAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["CodingAgent"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CounterAgent", "class_name": "CounterAgent" },
      { "name": "EchoAgent", "class_name": "EchoAgent" },
      { "name": "CodingAgent", "class_name": "CodingAgent" }
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
    "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr"
  },
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "CRON_SECRET"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
    { "binding": "CACHE_BUCKET", "bucket_name": "cloudless-assets" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
    { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
    { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cloudless-assets" }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "user-auth-db",
      "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
    }
  ],
  "env": {
    "staging": {
      "name": "cloudless-gr-staging",
      "routes": [
        { "pattern": "staging.cloudless.gr", "zone_id": "7025298073d6a5c645a6ad9add0cbf0e", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
        "NEXT_PUBLIC_SITE_URL": "https://cloudless.gr"
      },
      "r2_buckets": [
        { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "CACHE_BUCKET", "bucket_name": "cloudless-assets" },
        { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket" },
        { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics" },
        { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cloudless-assets" }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "user-auth-db",
          "database_id": "7ca74513-23c3-412a-b9ca-b0c55835973d"
        }
      ]
    }
  }
}
