# Wrangler CLI local development secrets
# Copy this file to .dev.vars and fill in the values
# .dev.vars is gitignored and never committed

# ─── Authentication ────────────────────────────────────────────────
AUTH_SECRET=your-next-auth-secret-here
AUTH_URL=http://localhost:8787
AUTH_TRUST_HOST=false

# ─── AWS Cognito ───────────────────────────────────────────────────
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret

# ─── AWS Credentials ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ─── Agent Authentication ──────────────────────────────────────────
AGENT_AUTH_TOKEN=your-agent-auth-token-here

# ─── Optional: External Services ───────────────────────────────────
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LANGGRAPH_URL=http://localhost:8123
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# TAVILY_API_KEY=your-tavily-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token