# Wrangler CLI local development secrets
# Copy this file to .dev.vars and fill in the values
# .dev.vars is gitignored and never committed

# ─── Cloudflare Workers ───────────────────────────────────────────────
# SESSION_SECRET is required for D1 password hashing
SESSION_SECRET=your-random-secret-for-password-hashing

# ─── Authentication (for local dev) ───────────────────────────────────
AUTH_SECRET=your-next-auth-secret-here
AUTH_URL=http://localhost:8787
AUTH_TRUST_HOST=false

# ─── Stripe (for checkout) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Agent Authentication ─────────────────────────────────────────────
AGENT_AUTH_TOKEN=your-agent-auth-token-here

# ─── Cloudflare R2 (for ETL scripts) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
ANALYTICS_BUCKET=datalake-bucket

# ─── Cloudflare Analytics Engine ─────────────────────────────────────────────
# Analytics Engine dataset is auto-provisioned via wrangler deploy.
# No local secret needed - uses binding at runtime.
# Dataset will be created as: cloudless_analytics

# ─── R2 Access (for parquet export) ─────────────────────────────────────────
# These are required for ETL scripts that write to R2
# CF_R2_ACCESS_KEY_ID and CF_R2_SECRET_ACCESS_KEY are from R2 keys
#   Console → R2 → Manage R2 API Tokens → Create token with read/write access

# ─── Google AI (Gemini) ─────────────────────────────────────────────────────
# Primary AI provider for chat and admin AI endpoints
# Get API key from https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Self-hosted Apps (auto-login) ──────────────────────────────────────────
# AppFlowy auto-login uses GoTrue password grant
APPFLOWY_API_URL=https://appflowy.cloudless.gr
APPFLOWY_EMAIL=your-appflowy-admin@example.com
APPFLOWY_PASSWORD=your-appflowy-password

# EspoCRM auto-login uses HTTP Basic Auth in the URL
ESPOCRM_BASE_URL=https://espocrm.cloudless.gr
ESPOCRM_API_USER=admin
ESPOCRM_API_PASSWORD=your-esprocrm-password

# ─── Optional: External Services ───────────────────────────────────────────
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LANGGRAPH_URL=http://localhost:8123
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# TAVILY_API_KEY=your-tavily-api-key
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token