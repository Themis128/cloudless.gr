# Wrangler CLI local development secrets
# Copy this file to .dev.vars and fill in the values
# .dev.vars is gitignored and never committed

# ─── Cloudflare Workers ───────────────────────────────────────────────
# SESSION_SECRET is required for D1 password hashing
SESSION_SECRET=your-random-secret-for-password-hashing

# ─── Authentication (for local dev) ───────────────────────────────────
AUTH_SECRET=your-next-auth-secret-here
AUTH_URL=http://localhost:8787
AUTH_TRUST_HOST=false

# ─── AWS Cognito (CLOUD AUTH PROVIDER - optional) ───────────────────────
# When NEXT_PUBLIC_AUTH_PROVIDER=d1 is set, D1 auth is used instead of Cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret

# ─── Stripe (for checkout) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Agent Authentication ─────────────────────────────────────────────
AGENT_AUTH_TOKEN=your-agent-auth-token-here

# ─── Cloudflare R2 (for ETL scripts) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
ANALYTICS_BUCKET=datalake-bucket

# ─── Optional: External Services ───────────────────────────────────────────
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LANGGRAPH_URL=http://localhost:8123
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# TAVILY_API_KEY=your-tavily-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
