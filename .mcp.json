{
  "mcpServers": {
    "fast-markdown": {
      "command": "npx",
      "args": ["tsx", "fast-markdown-mcp/src/index.ts"],
      "env": {
        "DEVDOCS_STORAGE_PATH": "${DEVDOCS_STORAGE_PATH:-/home/tbaltzakis/DevDocs/storage/markdown}"
      },
      "autoStart": true,
      "alwaysAllow": [
        "list_files",
        "read_file",
        "search_files",
        "get_toc"
      ]
    },
    "cloudflare-pages": {
      "command": "npx",
      "args": ["tsx", "cloudflare-pages-mcp/src/index.ts"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "fb7dc7b69b662480cd5961a4d1913c78"
      },
      "autoStart": false,
      "alwaysAllow": [
        "pages_list_projects",
        "pages_get_project",
        "pages_list_deployments",
        "pages_get_deployment_logs"
      ]
    },
    "cloudflare-bindings": {
      "command": "npx",
      "args": ["mcp-remote", "https://bindings.mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": true,
      "alwaysAllow": [
        "kv_namespaces_list",
        "kv_namespace_create",
        "kv_namespace_delete",
        "workers_list",
        "r2_buckets_list"
      ]
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "fb7dc7b69b662480cd5961a4d1913c78"
      },
      "autoStart": true
    },
    "cloudflare-graphql": {
      "command": "npx",
      "args": ["mcp-remote", "https://graphql.mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false
    },
    "cloudflare-docs": {
      "command": "npx",
      "args": ["mcp-remote", "https://docs.mcp.cloudflare.com/mcp"],
      "autoStart": false
    },
    "cloudflare-builds": {
      "command": "npx",
      "args": ["mcp-remote", "https://builds.mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false
    },
    "cloudflare-observability": {
      "command": "npx",
      "args": ["mcp-remote", "https://observability.mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false
    },
    "opennextjs-mcp": {
      "command": "node",
      "args": [
        "/home/tbaltzakis/opennextjs-cli/packages/opennextjs-mcp/dist/index.js"
      ],
      "env": {
        "PROJECT_ROOT": "/home/tbaltzakis/cloudless.gr"
      },
      "autoStart": false,
      "alwaysAllow": [
        "get_project_status",
        "validate_configuration",
        "deploy_to_cloudflare",
        "start_preview_server",
        "update_configuration",
        "check_health",
        "list_environments"
      ]
    }
  }
}