{
  "name": "cloudless-gr-preview",
  "main": "src/index-cloudflare-free.js",
  "compatibility_date": "2026-07-09",
  
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  
  "ai": { "binding": "AI" },
  
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudless_analytics_preview"
    }
  ],
  
  "r2_buckets": [
    { "binding": "ANALYTICS_BUCKET", "bucket_name": "cloudless-analytics-preview" },
    { "binding": "ASSETS_BUCKET", "bucket_name": "cloudless-assets-preview" },
    { "binding": "DATALAKE_BUCKET", "bucket_name": "datalake-bucket-preview" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "app-media-bucket-preview" }
  ],
  
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "auth-db-preview",
      "database_id": "70d90155-12de-46d7-a0ea-113b3e7127cf"
    }
  ],
  
  "send_email": [ { "name": "EMAIL" } ],
  
  "vars": {
    "API_VERSION": "v1.0",
    "APP_VERSION": "preview",
    "ENVIRONMENT": "preview",
    "NEXT_PUBLIC_AUTH_PROVIDER": "d1",
    "NEXT_PUBLIC_SITE_URL": "https://cloudless-gr-preview.YOUR_SUBDOMAIN.workers.dev"
  }
}