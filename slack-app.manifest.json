{
  "display_information": {
    "name": "Cloudless",
    "description": "Notifications from cloudless.gr — bookings, orders, errors & deploys",
    "background_color": "#0B1D51",
    "long_description": "The Cloudless bot delivers real-time notifications to your workspace: new consultation bookings, Stripe orders, application errors, deploy events, contact form submissions, and newsletter sign-ups. It also provides slash commands for quick status checks and operational visibility, a modal-based support ticket form, analytics summaries, and a guided production deploy flow."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Cloudless",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/cloudless-status",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "App health check — version and uptime",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-orders",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Recent Stripe orders",
        "usage_hint": "[count]",
        "should_escape": false
      },
      {
        "command": "/cloudless-channels",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "List notification channel status and bot membership",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-ticket",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Create a support ticket via modal form",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-analytics",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Stripe revenue summary (default) or LinkedIn ad metrics (`ads <slug>`)",
        "usage_hint": "[ads [<slug>|list|help]]",
        "should_escape": false
      },
      {
        "command": "/cloudless-deploy",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Trigger a production deployment via confirmation modal",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-draft",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Re-run the weekly article draft generator workflow",
        "usage_hint": "rerun",
        "should_escape": false
      },
      {
        "command": "/cloudless-newsletter",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "List drafts, approve+send a newsletter, or emergency-unpublish",
        "usage_hint": "list | send <slug> | unpublish <slug>",
        "should_escape": false
      },
      {
        "command": "/cloudless-help",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Show all available Cloudless slash commands",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-ads",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "LinkedIn campaign control — status, pause, resume, budget",
        "usage_hint": "status | pause | resume | budget <EUR>",
        "should_escape": false
      },
      {
        "command": "/cloudless-seo",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "SEO snapshot — top keywords, clicks, impressions, avg position",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-leads",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Recent leads from HubSpot CRM",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-errors",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Top unresolved Sentry errors",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-uptime",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Ping all endpoints — site, CloudFront, Pi origin",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-subscribers",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Newsletter subscriber count and recent signups",
        "usage_hint": "(no arguments)",
        "should_escape": false
      },
      {
        "command": "/cloudless-cache",
        "url": "https://cloudless.gr/api/slack/commands",
        "description": "Flush Notion content cache",
        "usage_hint": "[prefix]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:join",
        "channels:manage",
        "channels:read",
        "channels:write.invites",
        "chat:write",
        "chat:write.customize",
        "commands",
        "groups:read",
        "groups:write",
        "groups:write.invites",
        "im:history",
        "im:write",
        "team:read",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://cloudless.gr/api/slack/events",
      "bot_events": ["app_home_opened", "app_mention", "member_joined_channel", "message.im"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://cloudless.gr/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
