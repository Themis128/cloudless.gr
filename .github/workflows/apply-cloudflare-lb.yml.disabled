name: Apply Cloudflare HA load balancer (DNS cutover)

# Applies the cloudless.gr Cloudflare Load Balancer — health-checked failover
# from AWS (primary) to Pi/k3s (secondary). This is the APPLY variant of
# cloudflare-lb.yml (which runs in report-only mode on push).
#
# HOW TO USE (one-time setup):
#   1. Cloudflare dashboard → My Profile → API Tokens → Create Token
#      Use "Create custom token" with these permissions:
#        Zone → Zone → Read        (for cloudless.gr)
#        Zone → Load Balancing: Monitors and Pools → Edit
#        Zone → Load Balancing: Load Balancers → Edit
#        Zone → DNS → Edit         (for the DNS cutover to the LB)
#      Zone Resources: Include → Specific zone → cloudless.gr
#
#   2. Add the token as a GitHub Secret:
#        GitHub → repo Settings → Secrets and variables → Actions
#        → New repository secret → Name: CLOUDFLARE_API_TOKEN, Value: <token>
#
#   3. VERIFY FIRST: check cloudflare-lb.yml (the report-only variant) to
#      confirm the plan before committing to the DNS cutover. The report is
#      posted to issue #382 on every push to cloudflare-lb.yml.
#
#   4. Push any change to this file to apply (create monitors, pools, LB, DNS).
#      The job posts a full result to issue #382.
#
# WHAT IT DOES (idempotent, safe to re-run):
#   For cloudless.gr and www.cloudless.gr:
#     - Creates health monitors (GET /api/health, expect 200)
#     - Creates origin pools: AWS CloudFront (primary) + Pi Tailscale Funnel (secondary)
#     - Creates a Load Balancer that serves the first healthy pool
#     - Patches the DNS record to point to the LB (was a plain proxied A/CNAME)
#   Steady state is identical to today — all traffic goes to AWS; Pi is on standby.

on:
  # Dispatch-only. The push-on-self-edit trigger was removed because the
  # current Cloudflare token (in SSM) is scoped for the HA failover watchdog
  # only (Zone:Read + DNS:Edit). It lacks Load Balancing: Monitors and Pools
  # :Edit and Load Balancing: Load Balancers:Edit, so attempting to apply the
  # LB fails with "10000 Authentication error". The account also doesn't
  # currently subscribe to Cloudflare's Load Balancing add-on. The poor-man's
  # HA failover (ha-failover-watchdog.yml) replaces this workflow's function
  # for cloudless.gr — use that instead. Keep this workflow available for
  # manual dispatch in case the LB add-on is purchased in the future.
  workflow_dispatch:

permissions:
  id-token: write   # OIDC fallback — reads token from SSM if repo secret is absent
  contents: read
  issues: write

concurrency:
  group: cloudflare-lb
  cancel-in-progress: false

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  apply:
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v4.3.1

      # Fallback: if CLOUDFLARE_API_TOKEN repo secret is absent, the OIDC role
      # reads it from SSM /cloudless/production/CLOUDFLARE_API_TOKEN.
      - name: Configure AWS credentials (OIDC)
        continue-on-error: true
        uses: aws-actions/configure-aws-credentials@e7f100cf4c008499ea8adda475de1042d6975c7b # v6.2.0
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: us-east-1

      - name: Apply Cloudflare LB + DNS cutover
        id: apply
        env:
          AWS_REGION: us-east-1
          MODE: apply
          CONFIRM: "1"
          # GH secret is stale; script reads SSM. See cloudflare-token-rotate.yml.
        run: |
          set -o pipefail
          bash scripts/setup-cloudflare-lb.sh 2>&1 | tee cloudflare-lb.log

      - name: Post result to tracking issue
        if: always()
        run: |
          {
            echo "# Cloudflare HA load balancer — APPLY — $(date -u '+%F %T')Z"
            echo ""
            echo "**Mode:** apply (creates LB + DNS cutover)"
            echo "**Job:** ${{ job.status }}"
            echo ""
            echo '```'
            cat cloudflare-lb.log 2>/dev/null || echo '(no log)'
            echo '```'
          } > c.md
          gh issue comment 382 --repo "${{ github.repository }}" --body-file c.md
