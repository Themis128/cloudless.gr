# pnpm v10+ optimized settings for Next.js 16 + AWS Amplify
# Use isolated linker (default) for better dependency isolation
node-linker=isolated

# Peer dependency resolution
auto-install-peers=true

# Performance optimizations
shamefully-hoist=false
prefer-frozen-lockfile=false
prefer-workspace-packages=true

# Reduce noise
reporter=append-only

# Next.js / AWS Amplify compatibility
# These patterns ensure server-only packages are accessible in edge runtimes
public-hoist-pattern[]=*@aws-amplify/*
public-hoist-pattern[]=*@formatjs/*
public-hoist-pattern[]=*intl-messageformat*
public-hoist-pattern[]=*use-intl*
public-hoist-pattern[]=*next-intl/*

# OpenNext.js / Cloudflare Next.js optimizer
# These patterns ensure @opennextjs/cloudflare can find Next.js internals
public-hoist-pattern[]=*next*
public-hoist-pattern[]=*@opennextjs*

# Overrides (migrated from package.json for pnpm v10+)
# Format: overrides.<package-name>=<overridden-version> for all versions
# These are security and compatibility patches applied to all dependencies
overrides.fast-xml-builder=>>=1.1.7
overrides.brace-expansion=>>=5.0.6
overrides.js-cookie=>>=3.0.7
overrides.esbuild=>>=0.28.1
overrides.ws=>>=8.21.0
overrides.js-yaml=>>=4.2.0
overrides.markdown-it=>>=14.2.0
overrides.undici=>>=7.28.0
overrides.nodemailer=>>=8.0.11
overrides.'@babel/core'=8.0.0
overrides.'@ai-sdk/provider'>=3.0.0
