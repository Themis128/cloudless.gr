{
  "version": "2.0",
  "database": "cloudless_analytics",
  "s3_base": "s3://cloudless-data-lake/",
  "description": "AWS Athena data lake schema for Cloudless analytics platform",
  "tables": {
    "events": {
      "format": "ndjson",
      "description": "Real-time event tracking (page views, clicks, conversions)",
      "partitioned_by": ["year", "month", "day"],
      "columns": [
        {"name": "event_id", "type": "string", "description": "Unique event identifier"},
        {"name": "event_type", "type": "string", "description": "Event type (page_view, click, conversion, etc.)"},
        {"name": "user_id", "type": "string", "description": "User identifier"},
        {"name": "session_id", "type": "string", "description": "Session identifier"},
        {"name": "timestamp", "type": "timestamp", "description": "Event timestamp"},
        {"name": "properties", "type": "map<string,string>", "description": "Event properties"},
        {"name": "utm_source", "type": "string", "description": "UTM source parameter"},
        {"name": "utm_medium", "type": "string", "description": "UTM medium parameter"},
        {"name": "utm_campaign", "type": "string", "description": "UTM campaign parameter"},
        {"name": "page_url", "type": "string", "description": "Page URL"},
        {"name": "page_title", "type": "string", "description": "Page title"},
        {"name": "referrer", "type": "string", "description": "Referrer URL"},
        {"name": "year", "type": "int", "description": "Partition: year"},
        {"name": "month", "type": "int", "description": "Partition: month"},
        {"name": "day", "type": "int", "description": "Partition: day"}
      ]
    },
    "gsc_keywords": {
      "format": "parquet",
      "description": "Google Search Console keyword data",
      "partitioned_by": ["year", "month"],
      "columns": [
        {"name": "keyword", "type": "string"},
        {"name": "clicks", "type": "bigint"},
        {"name": "impressions", "type": "bigint"},
        {"name": "ctr", "type": "decimal(5,4)"},
        {"name": "position", "type": "decimal(5,2)"},
        {"name": "page", "type": "string"},
        {"name": "country", "type": "string"},
        {"name": "device", "type": "string"},
        {"name": "date", "type": "date"},
        {"name": "year", "type": "int"},
        {"name": "month", "type": "int"}
      ]
    },
    "stripe_transactions": {
      "format": "parquet",
      "description": "Stripe payment transactions",
      "partitioned_by": ["year", "month"],
      "columns": [
        {"name": "transaction_id", "type": "string"},
        {"name": "customer_id", "type": "string"},
        {"name": "email", "type": "string"},
        {"name": "amount", "type": "decimal(10,2)"},
        {"name": "currency", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "created_at", "type": "timestamp"},
        {"name": "product_id", "type": "string"},
        {"name": "product_name", "type": "string"},
        {"name": "subscription_id", "type": "string"},
        {"name": "invoice_id", "type": "string"},
        {"name": "year", "type": "int"},
        {"name": "month", "type": "int"}
      ]
    },
    "clients": {
      "format": "parquet",
      "description": "Client RFM and churn analysis",
      "columns": [
        {"name": "client_id", "type": "string"},
        {"name": "email", "type": "string"},
        {"name": "recency_days", "type": "int"},
        {"name": "frequency", "type": "int"},
        {"name": "monetary", "type": "decimal(10,2)"},
        {"name": "rfm_score", "type": "string"},
        {"name": "churn_probability", "type": "decimal(5,4)"},
        {"name": "segment", "type": "string"}
      ]
    }
  },
  "views": {
    "v_acquisition_funnel": {
      "description": "Daily acquisition funnel (sessions → signups → purchasers)",
      "sql": "SELECT * FROM cloudless_analytics.v_acquisition_funnel"
    },
    "v_aws_cost_by_service": {
      "description": "AWS cost by service (30d)",
      "sql": "SELECT * FROM cloudless_analytics.v_aws_cost_by_service"
    },
    "v_sentry_top_issues": {
      "description": "Top Sentry issues by 14d count",
      "sql": "SELECT * FROM cloudless_analytics.v_sentry_top_issues"
    },
    "v_n8n_workflow_health_30d": {
      "description": "n8n workflow success rate (30d)",
      "sql": "SELECT * FROM cloudless_analytics.v_n8n_workflow_health_30d"
    },
    "v_linkedin_ads_summary": {
      "description": "LinkedIn ads 90-day rollup",
      "sql": "SELECT * FROM cloudless_analytics.v_linkedin_ads_summary"
    },
    "v_espocrm_funnel": {
      "description": "EspoCRM lifecycle stage funnel",
      "sql": "SELECT * FROM cloudless_analytics.v_espocrm_funnel"
    },
    "v_selfhosted_health": {
      "description": "Self-hosted services health summary",
      "sql": "SELECT * FROM cloudless_analytics.v_selfhosted_health"
    },
    "v_attribution_by_source": {
      "description": "UTM source/medium attribution",
      "sql": "SELECT * FROM cloudless_analytics.v_attribution_by_source"
    },
    "v_espocrm_pipeline": {
      "description": "EspoCRM opportunity pipeline",
      "sql": "SELECT * FROM cloudless_analytics.v_espocrm_pipeline"
    },
    "v_lead_to_customer": {
      "description": "Lead-to-customer conversion funnel with RFM",
      "sql": "SELECT * FROM cloudless_analytics.v_lead_to_customer"
    },
    "v_gsc_top_keywords": {
      "description": "Top GSC keywords by clicks",
      "sql": "SELECT * FROM cloudless_analytics.v_gsc_top_keywords"
    }
  },
  "etl_pipelines": {
    "n8n-to-lake": {
      "schedule": "hourly",
      "target_table": "n8n_workflows",
      "source": "n8n API",
      "script": "scripts/etl/n8n-to-lake.mjs"
    },
    "postiz-to-lake": {
      "schedule": "hourly",
      "target_table": "postiz_posts",
      "source": "Postiz API",
      "script": "scripts/etl/postiz-to-lake.mjs"
    },
    "espocrm-to-lake": {
      "schedule": "hourly",
      "target_table": "espocrm_contacts",
      "source": "EspoCRM API",
      "script": "scripts/etl/espocrm-to-lake.mjs"
    },
    "sentry-to-lake": {
      "schedule": "hourly",
      "target_table": "sentry_issues",
      "source": "Sentry API",
      "script": "scripts/etl/sentry-to-lake.mjs"
    },
    "appflowy-to-lake": {
      "schedule": "daily",
      "target_table": "appflowy_pages",
      "source": "AppFlowy API",
      "script": "scripts/etl/appflowy-to-lake.mjs"
    },
    "stripe-to-lake": {
      "schedule": "daily",
      "target_table": "stripe_transactions",
      "source": "Stripe API",
      "script": "scripts/etl/stripe-to-lake.mjs"
    },
    "aws-cost-to-lake": {
      "schedule": "daily",
      "target_table": "aws_costs",
      "source": "AWS Cost Explorer",
      "script": "scripts/etl/aws-cost-to-lake.mjs"
    },
    "linkedin-ads-to-lake": {
      "schedule": "daily",
      "target_table": "linkedin_ads",
      "source": "LinkedIn Marketing API",
      "script": "scripts/etl/linkedin-ads-to-lake.mjs"
    },
    "clients-to-lake": {
      "schedule": "daily",
      "target_table": "clients",
      "source": "Computed from stripe_transactions",
      "script": "scripts/etl/clients-to-lake.mjs"
    },
    "portals-to-lake": {
      "schedule": "hourly",
      "target_table": "portals",
      "source": "SSM Client Portals",
      "script": "scripts/etl/portals-to-lake.mjs"
    },
    "gsc-to-lake": {
      "schedule": "daily",
      "target_table": "gsc_keywords",
      "source": "Google Search Console API",
      "script": "scripts/etl/gsc-to-lake.mjs"
    }
  }
}
