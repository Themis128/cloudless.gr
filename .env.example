# ──────────────────────────────────────────────────────────────────────────────
# cloudless.gr — environment variables template
#
# Copy to .env.local for local development. Production uses AWS SSM Parameter
# Store (path prefix /cloudless/production/) — see README.md § Secrets Management.
# ──────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
# AWS resources migrated to Cloudflare - see docs/cloudflare/aws-to-cloudflare-migration.md
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# SSM prefix for production secrets (set by SST deploy — do not set locally)
# SSM_PREFIX=/cloudless/production

# ── Campaign / launch gating ─────────────────────────────────────────────────
# Operational mode (default = unset / "false"): hides the "training & portfolio
# project — does not accept clients" notices (both the top banner and the
# footer paragraph). Required for paid-traffic campaigns to convert.
# Set to "true" only on staging / showcase builds where the disclaimer matters.
NEXT_PUBLIC_PORTFOLIO_MODE=false

# ── Auth (Cloudflare D1 — default) ───────────────────────────────────────────
# Password hashing + session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-at-least-32-chars
AUTH_SECRET=your-auth-secret-here
AUTH_URL=http://localhost:4000
AUTH_TRUST_HOST=true
# d1 = email/password against AUTH_DB (wrangler D1 / next-dev platform proxy).
# cognito = legacy Hosted UI — only when explicitly required.
NEXT_PUBLIC_AUTH_PROVIDER=d1

# ── Cognito (legacy — only if NEXT_PUBLIC_AUTH_PROVIDER=cognito) ──────────────
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=your-cognito-app-client-id
# COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
# COGNITO_DOMAIN=https://your-pool.auth.us-east-1.amazoncognito.com
# NEXT_PUBLIC_AUTH_PROVIDER=cognito

# ── Cloudflare Configuration ───────────────────────────────────────────────────
# Cloudflare Account ID (from Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Cloudflare API Token (for Workers AI, R2, etc.)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Cloudflare Email API Token (if using Cloudflare Email Service)
CLOUDFLARE_EMAIL_API_TOKEN=your-cloudflare-email-api-token

# ── SES (transactional email) ──────────────────────────────────────────────────
# AWS SES migrated to Cloudflare Email Service/Resend
# SES_FROM_EMAIL=hello@cloudless.gr
# SES_TO_EMAIL=admin@cloudless.gr
# AWS_SES_REGION=us-east-1

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_DEFAULT_CHANNEL=#general

# ── HubSpot CRM ───────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=your-hubspot-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-hubspot-portal-id

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_BLOG_DB_ID=your-blog-database-id
NOTION_SUBMISSIONS_DB_ID=your-submissions-database-id
NOTION_DOCS_DB_ID=your-docs-database-id
NOTION_PROJECTS_DB_ID=your-projects-database-id
NOTION_TASKS_DB_ID=your-tasks-database-id
NOTION_ANALYTICS_DB_ID=your-analytics-database-id
NOTION_CALENDAR_DB_ID=your-calendar-database-id
NOTION_REPORTS_DB_ID=your-reports-database-id
NOTION_GSC_REPORTS_DB_ID=your-gsc-reports-database-id
# ESP32 device + telemetry mirror (optional — feature is a no-op if unset)
NOTION_ESP32_DEVICES_DB_ID=your-esp32-devices-database-id
NOTION_ESP32_TELEMETRY_DB_ID=your-esp32-telemetry-database-id
NOTION_WEBHOOK_SECRET=your-notion-webhook-secret

# ── Pi Alert API (ESP32 sensor) ───────────────────────────────────────────────
# Server-side URL of the Alert API on the Pi cluster. Reachable from the
# Next.js server (Lambda or k3s pod), NOT from browsers. Defaults to the LAN.
ALERT_API_URL=http://192.168.1.128:30800
# Public wss:// URL for the browser-side log stream. Must be wss:// in
# production. Falls back to LAN ws:// in dev.
NEXT_PUBLIC_ALERT_WS_URL=ws://192.168.1.128:30800/ws/esp32-logs

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# GA4 Measurement ID — find it at analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-K05JWC4HTD

# ── Google (Calendar + Search Console) ────────────────────────────────────────
# Shared service account used for both Google Calendar and GSC.
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# ── Google Search Console ─────────────────────────────────────────────────────
# Domain property format: "sc-domain:cloudless.gr"
GSC_SITE_URL=sc-domain:cloudless.gr

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=baltzakisthemiscom
SENTRY_PROJECT=cloudless-gr
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ORG=baltzakisthemiscom

# ── Anthropic (AI Assistant) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# ── ActiveCampaign ────────────────────────────────────────────────────────────
ACTIVECAMPAIGN_API_URL=https://youraccountname.api-us1.com
ACTIVECAMPAIGN_API_TOKEN=your-activecampaign-api-token

# ── Google Ads ────────────────────────────────────────────────────────────────
# Requires developer token approval: https://ads.google.com/intl/en_us/home/tools/api-center/
# Access token is auto-generated at runtime from GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── LinkedIn Ads ──────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_AD_ACCOUNT_ID=your-ad-account-id
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your-org-id

# ── TikTok Ads ────────────────────────────────────────────────────────────────
# Get app_id + app_secret from https://ads.tiktok.com/marketing_api/apps
# Then complete OAuth via /api/admin/oauth/tiktok to obtain access_token + advertiser_id.
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── X (Twitter) Ads ───────────────────────────────────────────────────────────
# Ads API access must be approved at https://ads.x.com/help before X_AD_ACCOUNT_ID works.
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
X_AD_ACCOUNT_ID=

# ── Meta (Facebook/Instagram) ─────────────────────────────────────────────────
META_AD_ACCOUNT_ID=act_your-ad-account-id
META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
META_CAPI_ACCESS_TOKEN=your-capi-access-token
META_ACCESS_TOKEN=your-meta-access-token
META_PAGE_ID=your-meta-page-id
# Note: INSTAGRAM_BUSINESS_ACCOUNT_ID requires a Meta Business account without
# ad policy violations. See docs/ACTIVECAMPAIGN.md for setup.

# ── LinkedIn Ads (Insight Tag + Conversions API) ─────────────────────────────
# Partner ID (browser): Campaign Manager → Account Assets → Insight Tag.
# Numeric, e.g. 1234567 — exposed at build time, baked into the client bundle.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=your-linkedin-partner-id
# CAPI access token (server-only): Campaign Manager → Conversions → "Direct
# API". Never expose to the client. When unset, /api/campaigns/conversion is a
# 204 no-op and only the browser-side Insight Tag conversion runs.
LINKEDIN_CAPI_ACCESS_TOKEN=your-linkedin-capi-access-token

# ── Cron ─────────────────────────────────────────────────────────────────────
# Secret shared between Vercel Cron and the route handlers.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4000
APP_VERSION=0.1.0
# Plausible Analytics (cookie-free, no consent needed)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=


# Microsoft Clarity (free session recordings & heatmaps)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# R14: Sentry surface tagging
SENTRY_ENVIRONMENT=prod
NEXT_PUBLIC_SENTRY_ENVIRONMENT=prod
