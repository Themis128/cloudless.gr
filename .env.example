# ──────────────────────────────────────────────────────────────────────────────
# cloudless.gr — environment variables template
#
# Copy to .env.local for local development. Production uses Cloudflare D1
# app_config table and Wrangler secrets — see README.md § Secrets Management.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth (next-auth + D1) ───────────────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-minimum-32-chars-padded!!

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN is optional - needed for Slash commands (/cloudless-status)
# SLACK_WEBHOOK_URL provides sufficient functionality for alerts and notifications
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_DEFAULT_CHANNEL=#general

# ── HubSpot CRM ───────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=your-hubspot-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-hubhubspot-portal-id

# ── Appflowy ───────────────────────────────────────────────────────────────────
# Appflowy is replacing Notion as the headless CMS for blogs, docs, and content
APPFLOWY_API_URL=https://appflowy.cloudless.gr
APPFLOWY_API_KEY=your-appflowy-api-key
APPFLOWY_WORKSPACE_ID=your-workspace-id
APPFLOWY_BLOG_DOCS_ID=your-blog-docs-id
# ESP32 device + telemetry mirror (optional — feature is a no-op if unset)
APPFLOWY_ESP32_DEVICES_ID=your-esp32-devices-doc-id
APPFLOWY_ESP32_TELEMETRY_ID=your-esp32-telemetry-doc-id
APPFLOWY_WEBHOOK_SECRET=your-appflowy-webhook-secret

# ── Pi Alert API (ESP32 sensor) ───────────────────────────────────────────────
# Server-side URL of the Alert API on the Pi cluster. Reachable from the
# Next.js server (Lambda or k3s pod), NOT from browsers. Defaults to the LAN.
ALERT_API_URL=http://192.168.1.128:30800
# Public wss:// URL for the browser-side log stream. Must be wss:// in
# production so it works from https://cloudless.online. Falls back to LAN
# ws:// in dev. Suggested production value:
#   NEXT_PUBLIC_ALERT_WS_URL=wss://logs.cloudless.online/ws/esp32-logs
NEXT_PUBLIC_ALERT_WS_URL=ws://192.168.1.128:30800/ws/esp32-logs

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# GA4 Measurement ID — find it at analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google (Calendar + Search Console) ────────────────────────────────────────
# Shared service account used for both Google Calendar and GSC.
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY should be set via Wrangler secret for security (newlines as \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# ── Google Search Console ─────────────────────────────────────────────────────
# Domain property format: "sc-domain:cloudless.gr"
GSC_SITE_URL=sc-domain:cloudless.gr

# ── Google AI (Gemini) ─────────────────────────────────────────────────────────
# Used for chat and admin AI endpoints. Get API key from https://ai.google.dev/
# This is the PRIMARY AI provider for the application.
GEMINI_API_KEY=AIzaSy...

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=baltzakisthemiscom
SENTRY_PROJECT=cloudless-gr
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ORG=baltzakisthemiscom

# ── ActiveCampaign ────────────────────────────────────────────────────────────
ACTIVECAMPAIGN_API_URL=https://youraccountname.api-us1.com
ACTIVECAMPAIGN_API_TOKEN=your-activecampaign-api-token

# ── Google Ads ────────────────────────────────────────────────────────────────
# Requires developer token approval: https://ads.google.com/intl/en_us/home/tools/api-center/
# Access token is auto-generated at runtime from GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── LinkedIn Ads ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_AD_ACCOUNT_ID=your-ad-account-id
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your-org-id

# ── TikTok Ads ────────────────────────────────────────────────────────────────
# Get app_id + app_secret from https://ads.tiktok.com/marketing_api/apps
# Then complete OAuth via /api/admin/oauth/tiktok to obtain access_token + advertiser_id.
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── X (Twitter) Ads ───────────────────────────────────────────────────────────
# Ads API access must be approved at https://ads.x.com/help before X_AD_ACCOUNT_ID works.
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
X_AD_ACCOUNT_ID=

# ── Meta (Facebook/Instagram) ─────────────────────────────────────────────────
META_AD_ACCOUNT_ID=act_your-ad-account-id
META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
META_CAPI_ACCESS_TOKEN=your-capi-access-token
META_ACCESS_TOKEN=your-meta-access-token
META_PAGE_ID=your-meta-page-id
# Note: INSTAGRAM_BUSINESS_ACCOUNT_ID requires a Meta Business account without
# ad policy violations. See docs/ACTIVECAMPAIGN.md for setup.

# ── Admin Alerts ───────────────────────────────────────────────────────────────
# Shared secret for authenticating /api/webhooks/admin-alert endpoint.
# Used by Sentry, Pi alert-api, and other internal monitoring sources.
ADMIN_ALERT_SECRET=your-admin-alert-secret-here
# Fallback for existing callers (deprecated - use ADMIN_ALERT_SECRET instead)
CONTENT_WEBHOOK_SECRET=your-content-webhook-secret-here

# ── Cron ─────────────────────────────────────────────────────────────────────
# Secret shared between Vercel Cron and the route handlers.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4000
APP_VERSION=0.1.0