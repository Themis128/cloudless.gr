# Helm values overlay containing every sensitive env var.
# 1. Copy to secrets-overrides.yaml
# 2. Fill in every REPLACE_* placeholder
# 3. Add `05-postiz/secrets-overrides.yaml` to .gitignore — DO NOT COMMIT
# 4. Pass via `-f 05-postiz/secrets-overrides.yaml` to helm upgrade

secrets:
  # ---- Core ----
  # `openssl rand -base64 48`
  JWT_SECRET: "REPLACE_WITH_LONG_RANDOM_STRING"

  # DSN built from CNPG app user (see 02-cnpg/postiz-db-secret.yaml).
  DATABASE_URL: "postgresql://postiz:REPLACE_WITH_PG_PASSWORD@postiz-pg-rw.postiz.svc.cluster.local:5432/postiz"

  # Bitnami Redis auto-generates a password on first install. After running install.sh:
  #   kubectl -n postiz get secret postiz-redis -o jsonpath='{.data.redis-password}' | base64 -d
  REDIS_URL: "redis://:REPLACE_WITH_REDIS_PASSWORD@postiz-redis-master.postiz.svc.cluster.local:6379"

  # ---- S3 storage (MinIO via Postiz's cloudflare/S3 client path) ----
  CLOUDFLARE_ACCOUNT_ID: "minio"
  CLOUDFLARE_ACCESS_KEY: "postiz-app"
  CLOUDFLARE_SECRET_ACCESS_KEY: "REPLACE_WITH_MINIO_APP_SECRET"
  CLOUDFLARE_BUCKETNAME: "postiz-uploads"
  CLOUDFLARE_BUCKET_URL: "http://minio.postiz.svc.cluster.local/postiz-uploads/"

  # ---- Social provider OAuth (fill the ones you actually use) ----
  X_API_KEY: ""
  X_API_SECRET: ""
  LINKEDIN_CLIENT_ID: ""
  LINKEDIN_CLIENT_SECRET: ""
  REDDIT_CLIENT_ID: ""
  REDDIT_CLIENT_SECRET: ""
  GITHUB_CLIENT_ID: ""
  GITHUB_CLIENT_SECRET: ""

  # ---- Optional integrations ----
  RESEND_API_KEY: ""
