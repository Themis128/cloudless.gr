# Rename to postiz-db-secret.yaml, generate strong passwords (e.g. `openssl rand -base64 32`),
# then `kubectl apply -f`. CNPG will use these when bootstrapping the cluster.
---
apiVersion: v1
kind: Secret
metadata:
  name: postiz-pg-app-user
  namespace: postiz
type: kubernetes.io/basic-auth
stringData:
  username: postiz
  password: REPLACE_WITH_STRONG_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: postiz-pg-superuser
  namespace: postiz
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: REPLACE_WITH_STRONG_SUPERUSER_PASSWORD
