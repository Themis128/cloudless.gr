# Rename to secret.yaml, paste the API key from
# https://postiz.cloudless.gr Settings -> Developers -> Public API, then apply.
apiVersion: v1
kind: Secret
metadata:
  name: postiz-api-key
  namespace: postiz
type: Opaque
stringData:
  POSTIZ_API_KEY: "REPLACE_WITH_POSTIZ_PUBLIC_API_KEY"
  POSTIZ_API_URL: "https://postiz.cloudless.gr"
