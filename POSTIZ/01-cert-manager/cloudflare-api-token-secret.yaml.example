# Rename to cloudflare-api-token-secret.yaml and fill in the token before applying.
# Create the API token in Cloudflare with: Zone > Zone:Read + Zone > DNS:Edit (for cloudless.gr).
# https://developers.cloudflare.com/api/tokens/create/
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: REPLACE_WITH_CLOUDFLARE_API_TOKEN
