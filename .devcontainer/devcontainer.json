{
  "name": "cloudless.gr",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=cloudless-pnpm-store,target=/pnpm-store,type=volume"
  ],
  "remoteUser": "node",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript / Next.js
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens",
        "wix.vscode-import-cost",
        "lokalise.i18n-ally",
        // Testing
        "vitest.explorer",
        "ms-playwright.playwright",
        // AWS / SST
        "amazonwebservices.aws-toolkit-vscode",
        "sst.ion",
        // API testing
        "humao.rest-client",
        // Code quality
        "sonarsource.sonarlint-vscode",
        "streetsidesoftware.code-spell-checker",
        // Git / GitHub
        "eamodio.gitlens",
        "github.copilot",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        // Docker / Kubernetes
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        // Cloudflare Workers
        "cloudflare.cloudflare-workers-bindings",
        // Productivity
        "gruntfuggly.todo-tree",
        "alefragnani.bookmarks"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "i18n-ally.localesPaths": ["src/locales"],
        "i18n-ally.keystyle": "nested",
        "i18n-ally.sourceLanguage": "en",
        "i18n-ally.enabledFrameworks": ["next-intl"],
        "tailwindCSS.experimental.classRegex": [
          ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"],
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"]
        ]
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteEnv": {
    "NEXT_PUBLIC_COGNITO_USER_POOL_ID": "${localEnv:NEXT_PUBLIC_COGNITO_USER_POOL_ID}",
    "NEXT_PUBLIC_COGNITO_CLIENT_ID": "${localEnv:NEXT_PUBLIC_COGNITO_CLIENT_ID}"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev server",
      "onAutoForward": "openPreview"
    }
  }
}
