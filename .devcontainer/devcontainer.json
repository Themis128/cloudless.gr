{
  "name": "cloudless.gr",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=cloudless-pnpm-store,target=/pnpm-store,type=volume"
  ],
  "remoteUser": "node",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens",
        "yoavbls.pretty-ts-errors",
        "wix.vscode-import-cost",
        "steoates.autoimport",
        "lokalise.i18n-ally",
        "vitest.explorer",
        "ms-playwright.playwright",
        "amazonwebservices.aws-toolkit-vscode",
        "amazonwebservices.amazon-q-vscode",
        "sst.ion",
        "humao.rest-client",
        "hubspot.hubl",
        "maglabs.hubspot-hubl-snippets",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "sonarsource.sonarlint-vscode",
        "streetsidesoftware.code-spell-checker",
        "stylelint.vscode-stylelint",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.copilot",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "esphome.esphome-vscode",
        "platformio.platformio-ide",
        "cloudflare.cloudflare-workers-bindings-extension",
        "figma.figma-vscode-extension",
        "frenco.vscode-notion",
        "gruntfuggly.todo-tree",
        "alefragnani.bookmarks"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.fixAll.stylelint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "prettyTypeErrors.enable": true,
        "i18n-ally.localesPaths": ["src/locales"],
        "i18n-ally.keystyle": "nested",
        "i18n-ally.sourceLanguage": "en",
        "i18n-ally.enabledFrameworks": ["next-intl"],
        "tailwindCSS.experimental.classRegex": [
          ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"],
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"]
        ],
        "yaml.customTags": ["!secret scalar"],
        "python.defaultInterpreterPath": "python3",
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteEnv": {
    "NEXT_PUBLIC_COGNITO_USER_POOL_ID": "${localEnv:NEXT_PUBLIC_COGNITO_USER_POOL_ID}",
    "NEXT_PUBLIC_COGNITO_CLIENT_ID": "${localEnv:NEXT_PUBLIC_COGNITO_CLIENT_ID}",
    "CLOUDFLARE_API_TOKEN": "${localEnv:CLOUDFLARE_API_TOKEN}",
    "CLOUDFLARE_ACCOUNT_ID": "${localEnv:CLOUDFLARE_ACCOUNT_ID}",
    "TAILSCALE_API_KEY": "${localEnv:TAILSCALE_API_KEY}",
    "BRAVE_API_KEY": "${localEnv:BRAVE_API_KEY}",
    "POSTIZ_API_KEY": "${localEnv:POSTIZ_API_KEY}",
    "BRAND_SYSTEM_API_KEY": "${localEnv:BRAND_SYSTEM_API_KEY}"
  },

  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Next.js dev server",
      "onAutoForward": "openPreview"
    }
  }
}