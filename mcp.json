{
  "mcpServers": {
    "ollama": {
      "command": "npx",
      "args": [
        "tsx",
        "src/index.ts"
      ],
      "env": {
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "qwen2.5-coder",
        "OLLAMA_TIMEOUT_MS": "120000"
      },
      "autoStart": true,
      "cwd": "tools/mcp-ollama-server"
    },
    "cloudless-infra": {
      "command": "npx",
      "args": [
        "tsx",
        "src/index.ts"
      ],
      "env": {
        "OMV_SSH_HOST_TAILSCALE": "100.113.41.119",
        "OMV_SSH_USER": "omv",
        "OMV_SSH_KEY": "${HOME}/.ssh/id_ed25519",
        "OMV_SSH_KEY_CONTENTS": "${OMV_SSH_KEY_CONTENTS}"
      },
      "cwd": "tools/ssh-mcp"
    },
    "cognito-setup": {
      "command": "npx",
      "args": [
        "tsx",
        "src/index.ts"
      ],
      "autoStart": false,
      "cwd": "tools/cognito-setup-mcp"
    },
    "athena": {
      "command": "npx",
      "args": [
        "tsx",
        "index.ts"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "ATHENA_WORKGROUP": "primary",
        "ATHENA_DATABASE": "cloudless_analytics",
        "ATHENA_S3_OUTPUT_BUCKET": "cloudless-athena-results"
      },
      "autoStart": false,
      "cwd": "tools/mcp-athena-server"
    },
    "project": {
      "command": "npx",
      "args": [
        "-y",
        "project-mcp"
      ],
      "autoStart": true
    },
    "langsmith": {
      "command": "uvx",
      "args": [
        "langsmith-mcp"
      ],
      "env": {
        "LANGSMITH_API_KEY": "${LANGSMITH_API_KEY}"
      },
      "autoStart": true
    },
    "github.com/github-mcp-server": {
      "command": "node",
      "args": [
        "tools/github-mcp-server/index.js"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "autoStart": false
    },
    "github.com/Flux159/mcp-server-kubernetes": {
      "command": "npx",
      "args": ["mcp-server-kubernetes"],
      "autoStart": false
    },
    "github.com/modelcontextprotocol/servers/tree/main/src/sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "autoStart": false
    }
  }
}
```
