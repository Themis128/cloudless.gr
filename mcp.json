{
  "mcpServers": {
    "ollama": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "env": {
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "qwen2.5-coder",
        "OLLAMA_TIMEOUT_MS": "120000"
      },
      "autoStart": true,
      "cwd": "tools/mcp-ollama-server"
    },
    "cloudless-infra": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "env": {
        "OMV_SSH_HOST": "192.168.1.128",
        "OMV_SSH_HA_HOST": "192.168.1.130",
        "OMV_SSH_USER": "tbaltzakis",
        "OMV_SSH_KEY": "${HOME}/.ssh/id_ed25519"
      },
      "autoStart": true,
      "cwd": "tools/ssh-mcp"
    },
    "kubernetes": {
      "command": "npx",
      "args": ["mcp-server-kubernetes"],
      "autoStart": false
    },
    "cloudflare": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "autoStart": false
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "autoStart": false
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/tbaltzakis/cloudless.gr"],
      "autoStart": false
    },
    "athena": {
      "command": "npx",
      "args": ["tsx", "index.ts"],
      "env": {
        "AWS_REGION": "us-east-1",
        "ATHENA_WORKGROUP": "primary",
        "ATHENA_DATABASE": "cloudless_analytics",
        "ATHENA_S3_OUTPUT_BUCKET": "cloudless-athena-results"
      },
      "autoStart": false,
      "cwd": "tools/mcp-athena-server"
    },
    "cognito-setup": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "autoStart": false,
      "cwd": "tools/cognito-setup-mcp"
    },
    "markdownify": {
      "command": "node",
      "args": ["/home/tbaltzakis/Cline/MCP/markdownify-mcp/dist/index.js"],
      "env": {
        "MARKITDOWN_PATH": "/home/tbaltzakis/Cline/MCP/markdownify-mcp/.venv/bin/markitdown"
      },
      "autoStart": false
    },
    "aws-knowledge": {
      "command": "npx",
      "args": ["mcp-remote", "https://knowledge-mcp.global.api.aws"],
      "autoStart": false
    },
    "github.com/cloudflare/mcp-server-cloudflare": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.cloudflare.com/mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "autoStart": false
    }
  }
}
