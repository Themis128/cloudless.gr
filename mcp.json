{
  "mcpServers": {
    "ollama": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/mcp-ollama-server/src/index.ts"
      ],
      "env": {
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "qwen2.5-coder",
        "OLLAMA_TIMEOUT_MS": "120000"
      },
      "autoStart": true
    },
    "cloudless-infra": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/ssh-mcp/src/index.ts"
      ],
      "env": {
        "OMV_SSH_HOST_TAILSCALE": "100.113.41.119",
        "OMV_SSH_USER": "omv",
        "OMV_SSH_KEY": "${HOME}/.ssh/id_ed25519",
        "OMV_SSH_KEY_CONTENTS": "${OMV_SSH_KEY_CONTENTS}"
      }
    },
    "cognito-setup": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/cognito-setup-mcp/src/index.ts"
      ],
      "autoStart": false
    },
    "athena": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/mcp-athena-server/index.ts"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "ATHENA_WORKGROUP": "primary",
        "ATHENA_DATABASE": "cloudless_analytics",
        "ATHENA_S3_OUTPUT_BUCKET": "cloudless-athena-results"
      },
      "autoStart": false
    },
    "project": {
      "command": "npx",
      "args": [
        "-y",
        "project-mcp"
      ],
      "autoStart": true
    },
    "langsmith": {
      "command": "uvx",
      "args": [
        "langsmith-mcp"
      ],
      "env": {
        "LANGSMITH_API_KEY": "${LANGSMITH_API_KEY}"
      },
      "autoStart": true
    }
  }
}
