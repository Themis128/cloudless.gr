{
  "mcpServers": {
    "cloudless-infra": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/ssh-mcp/src/index.ts"
      ],
      "env": {
        "OMV_SSH_HOST_TAILSCALE": "100.113.41.119",
        "OMV_SSH_HA_HOST_TAILSCALE": "100.111.222.92",
        "OMV_SSH_USER": "tbaltzakis",
        "OMV_SSH_KEY": "${HOME}/.ssh/id_ed25519",
        "OMV_SSH_KEY_CONTENTS": "${OMV_SSH_KEY_CONTENTS}",
        "OMV_SSH_PASSPHRASE": "${OMV_SSH_PASSPHRASE}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "project": {
      "command": "npx",
      "args": [
        "-y",
        "project-mcp"
      ],
      "autoStart": true
    },
    "cloudflare": {
      "command": "npx",
      "args": [
        "-y",
        "@cloudflare/mcp-server-cloudflare"
      ],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID}"
      },
      "autoStart": true
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-docker"
      ],
      "autoStart": true
    },
    "tailscale": {
      "command": "npx",
      "args": [
        "-y",
        "@hexsleeves/tailscale-mcp-server"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}"
      },
      "autoStart": true
    },
    "brand-system": {
      "command": "npx",
      "args": [
        "-y",
        "@brandsystem/mcp"
      ],
      "env": {
        "BRAND_SYSTEM_API_KEY": "${BRAND_SYSTEM_API_KEY}",
        "BRAND_SYSTEM_SITE": "https://cloudless.gr"
      }
    },
    "postiz": {
      "command": "npx",
      "args": [
        "-y",
        "@postiz/mcp"
      ],
      "env": {
        "POSTIZ_API_URL": "https://postiz.cloudless.gr",
        "POSTIZ_API_KEY": "${POSTIZ_API_KEY}"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequentialthinking"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    }
  }
}