# ESPHome secrets — copy to secrets.yaml and fill in your values.
# This file is committed; secrets.yaml is gitignored.
#
# Usage: esphome compile cloudless-watchdog.yaml
#        (ESPHome reads secrets.yaml automatically from the same directory)

wifi_ssid:    "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback AP password (used when Wi-Fi fails)
ap_password: "cloudless-fallback"

# ntfy.sh push-notification token (Bearer token for cloudless-alerts topic)
ntfy_token: "YOUR_NTFY_TOKEN"

# ESPHome native API encryption key (base64, 32 bytes)
# Generate: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "YOUR_BASE64_API_KEY"

# OTA password — also used for PlatformIO OTA env (ESPHOME_OTA_PASSWORD)
ota_password: "YOUR_OTA_PASSWORD"
