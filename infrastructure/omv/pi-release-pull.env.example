# /etc/cloudless/pi-release-pull.env — mode 600, root:root
# Copy to omv and fill values. Never commit real secrets.

DEPLOY_ORCHESTRATOR_URL=https://pi-deploy-orchestrator.YOUR_SUBDOMAIN.workers.dev
DEPLOY_ORCHESTRATOR_TOKEN=replace-me

# Skip pull when 1-minute load average exceeds this (Pi 5 ~4 cores → 6 is busy)
LOAD1_MAX=6
# Skip when mpstat iowait % exceeds this (0 = disable check)
IOWAIT_MAX_PCT=40

# Optional S3 fallback if GET /artifact is unavailable:
# CF_ACCOUNT_ID=fb7dc7b69b662480cd5961a4d1913c78
# CF_R2_ACCESS_KEY_ID=replace-me
# CF_R2_SECRET_ACCESS_KEY=replace-me
# R2_BUCKET=cloudless-pi-releases
