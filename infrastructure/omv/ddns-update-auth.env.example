# Copy to /etc/cloudless/ddns-update-auth.env on omv.
# Do not commit the real file with secrets.

# Cloudflare API token with DNS edit permission for the target zone.
CF_API_TOKEN=

# Cloudflare zone ID for cloudless.gr.
CF_ZONE_ID=

# Either set CF_RECORD_ID directly, or set CF_RECORD_NAME and let the script discover the ID.
CF_RECORD_ID=
CF_RECORD_NAME=auth.cloudless.gr

CF_RECORD_TYPE=A
CF_PROXIED=false
DDNS_TTL=120

# Public IPv4 discovery endpoint.
DDNS_IP_URL=https://api.ipify.org
