# ARM64 llama-cpp-python OpenAI-compatible server Dockerfile for Pi 5
# Runs OpenAI-compatible API with GGUF quantized models on ARM64 CPU

FROM --platform=linux/arm64 python:3.11-slim

RUN apt-get update && apt-get install -y \
    curl ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install llama-cpp-python with ARM64 support
RUN pip install --no-cache-dir llama-cpp-python[server]

# Create model cache directory
RUN mkdir -p /model-cache

WORKDIR /model-cache

# Download Qwen-7B-Instruct Q4_K_M GGUF by default
# (smaller model, ~4GB, works well on Pi 5)
RUN curl -L -o /model-cache/qwen-instruct-q4.gguf \
    https://huggingface.co/Qwen/Qwen2.5-7B-Instruct-GGUF/resolve/main/qwen2.5-7b-instruct-q4_k_m.gguf

# Expose OpenAI-compatible API port
EXPOSE 8000

# Start OpenAI-compatible server
ENTRYPOINT ["python", "-m", "llama_cpp.server", "--model", "/model-cache/qwen-instruct-q4.gguf", "--host", "0.0.0.0", "--port", "8000"]
