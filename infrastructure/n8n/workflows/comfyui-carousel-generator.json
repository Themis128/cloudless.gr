        ]
      },
      "name": "Set Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/{{$json.prompt_id}}",
        "responseFormat": "json",
        "options": {}
      },
      "name": "HTTP Request (Get Status Second Attempt)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "completed"
            }
          ]
        }
      },
      "name": "IF (Check Status Second Attempt)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        500
      ]
    },
    {
      "parameters": {
        "command": "rm -f",
        "inputDataField": "",
        "arguments": [
          "/tmp/slide_*.png",
          "/tmp/cloudless_*.pdf"
        ],
        "options": {}
      },
      "name": "Cleanup Temporary Files",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        3250,
        300
      ]
    }
