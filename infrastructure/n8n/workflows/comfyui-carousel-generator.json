{
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "mode": "everyDay",
            "hour": 0,
            "minute": 0
          }
        ]
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "return [\n  {\n    text: \"server topology, cloud computing, serverless edge grid, deep blue and orange glowing lines\",\n    comfyPrompt: \"server topology, cloud computing, serverless edge grid, deep blue and orange glowing lines\"\n  },\n  {\n    text: \"wasted database infrastructure, digital currency drain, sleek technical matrix backdrop\",\n    comfyPrompt: \"wasted database infrastructure, digital currency drain, sleek technical matrix backdrop\"\n  },\n  {\n    text: \"ultra-fast edge node networks, cloudflare workers architecture visualization, high-speed fiber data streams\",\n    comfyPrompt: \"ultra-fast edge node networks, cloudflare workers architecture visualization, high-speed fiber data streams\"\n  },\n  {\n    text: \"clean tech abstract surface, neon blue optimization lines, professional minimal presentation frame\",\n    comfyPrompt: \"clean tech abstract surface, neon blue optimization lines, professional minimal presentation frame\"\n  }\n];"
      },
      "name": "Carousel Blueprint",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "inputDataProperty": "json"
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": {
          "prompt": "={{ $json.comfyPrompt }}"
        }
      },
      "name": "HTTP Request (Trigger ComfyUI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/{{$json.prompt_id}}",
        "responseFormat": "json",
        "options": {}
      },
      "name": "HTTP Request (Get Status)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "completed"
            }
          ]
        }
      },
      "name": "IF (Check Status)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        100
      ]
    },
    {
      "parameters": {
        "seconds": 5
      },
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/{{$json.filename}}",
        "responseFormat": "binary",
        "options": {}
      },
      "name": "HTTP Request (Download PNG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1750,
        100
      ]
    },
    {
      "parameters": {
        "options": {},
        "fileName": "/tmp/slide_{{ $node[\"Split In Batches\" ].index }}.png"
      },
      "name": "Write Binary File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        2000,
        100
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "set": [
          {
            "name": "filePath",
            "value": "/tmp/slide_{{ $node[\"Split In Batches\" ].index }}.png"
          }
        ]
      },
      "name": "Set File Path",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        2250,
        100
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "keepOnlySet": true,
        "set": [
          {
            "name": "filePaths",
            "value": "={{ $json.filePath }}"
          }
        ]
      },
      "name": "Merge (Collect File Paths)",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        2500,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  slides: [\n    {\n      title: \"Serverless Frameworks\",\n      subtitle: \"Eliminate infrastructure bloat\",\n      overline: \"OPTIMIZE YOUR STACK\",\n      stepNumber: \"1\",\n      body: \"Deploy globally with zero configuration\"\n    },\n    {\n      title: \"Edge Computing\",\n      subtitle: \"Bring computation to the data source\",\n      overline: \"ACCELERATE PERFORMANCE\",\n      stepNumber: \"2\",\n      body: \"Process data closer to users for lightning-fast response times\"\n    },\n    {\n      title: \"Cloud Cost Reduction\",\n      subtitle: \"Save up to 70% on infrastructure\",\n      overline: \"REDUCE CLOUD SPEND\",\n      stepNumber: \"3\",\n      body: \"Eliminate wasted resources and optimize utilization\"\n    },\n    {\n      title: \"Free 30-Minute Audit\",\n      subtitle: \"Get personalized recommendations\",\n      overline: \"BOOK YOUR CONSULTATION\",\n      body: \"Let our experts analyze your current architecture\"\n    }\n  ]\n}];"
      },
      "name": "Prepare Payload for generate.js",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2750,
        300
      ]
    },
    {
      "parameters": {
        "command": "node generate.js",
        "inputDataField": "json",
        "arguments": [
          "={{ JSON.stringify($json) }}",
          "./tmp/cloudless_final_deck.pdf"
        ],
        "options": {}
      },
      "name": "Execute Command (generate.js)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        3000,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "set": [
          {
            "name": "error",
            "value": "ComfyUI generation failed: status not completed after 2 attempts"
