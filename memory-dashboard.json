{
  "dashboard": {
    "title": "Cloudless Infrastructure Monitoring",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "timeseries",
        "title": "Memory Usage (by Pod)",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{container!=\"\",pod!=\"\"}) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Memory Growth (30m) — Leak Indicator",
        "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
        "targets": [
          {
            "expr": "increase(container_memory_usage_bytes{container!=\"\",pod!=\"\"}[30m])",
            "legendFormat": "{{pod}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "type": "stat",
        "title": "Fly.io Proxy Status",
        "gridPos": { "x": 0, "y": 20, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "up{job=\"fly-proxy\"}",
            "legendFormat": "Fly.io Proxy",
            "refId": "C"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Primary Backend Health",
        "gridPos": { "x": 8, "y": 20, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "probe_success{target=\"cloudless.gr\"}",
            "legendFormat": "cloudless.gr",
            "refId": "D"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Fallback Backend Health",
        "gridPos": { "x": 16, "y": 20, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "probe_success{target=\"omv.tail8eb71.ts.net\"}",
            "legendFormat": "Pi k3s",
            "refId": "E"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
