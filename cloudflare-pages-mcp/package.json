{
	"name": "@cloudless/cloudflare-pages-mcp",
	"version": "2.0.0",
	"description": "MCP server for Cloudflare Pages management with type-safe tools and evaluations",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"start": "node src/index.js",
		"dev": "tsx src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"eval": "vitest run --mode evals"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"mcp",
		"cloudflare",
		"pages",
		"cloudless"
	],
	"license": "MIT"
}
