{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "incremental": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "sst.config.ts",
    "sst.config.*.ts",
    "playwright.config.mts",
    "playwright.production.config.mts",
    "playwright.k3s.config.mts",
    "e2e",
    ".claude",
    "scripts",
    "tools",
    "workers",
    "agents",
    "cloudflare-pages-mcp",
    "fast-markdown-mcp",
    "tests",
    "infrastructure",
    "src/index.ts",
    "src/index-cloudflare-free.js",
    "src/agents",
    "vitest.config.mts",
    "vitest.config.ts",
    "vitest.workspace.mts",
    "vitest.workspace.ts",
    "vitest.integration.config.mts",
    "vitest.integration.config.ts"
  ]
}